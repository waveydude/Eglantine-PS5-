+            const ImageMayFailScope may_fail{FailBackableImages() && !ImageRefusalEnds()};
             make();
             return true;
         } catch (const vk::Exception& refused) {
diff --git a/src/video_core/vulkan_common/unbacked_fallback.h b/src/video_core/vulkan_common/unbacked_fallback.h
new file mode 100644
index 0000000..fe8934b
--- /dev/null
+++ b/src/video_core/vulkan_common/unbacked_fallback.h
@@ -0,0 +1,51 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include "common/common_types.h"
+#include "common/pe_switch.h"
+
+namespace Vulkan {
+
+/// Images larger than this are never backed (title 1's sparse texture arrays reach 4.5G texels,
+/// ~23 GB): VMA would quietly place them in system memory once VRAM is full.
+constexpr u64 MaxBackedImageTexels = u64{1} << 28;
+
+/// EDEN_UP_FRITCHII_UNBACKED=1 (off unless set; zortos293/Lichii#880 a07eed1ad9, as Fritchii
+/// 73880e166a): a texture cache image no memory is left for fails instead of becoming an
+/// unbacked sparse image (reads return zero, writes are dropped; an unbacked render target is
+/// drawn into, which AMD's drivers, RADV included, do not survive). The texture cache leaves it
+/// out (JoinImages' refusal path) until the collector has freed memory.
+[[nodiscard]] inline bool FailBackableImages() {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_FRITCHII_UNBACKED");
+    return enabled;
+}
+
+/// Set on this thread while the texture cache makes an image it can do without
+/// (TextureCacheRuntime::SurvivesImageRefusal, only with the switch on). Every other caller of
+/// MemoryAllocator::CreateImage keeps the unbacked fallback.
+inline thread_local bool g_image_may_fail = false;
+
+class ImageMayFailScope {
+public:
+    explicit ImageMayFailScope(bool may_fail) noexcept : previous{g_image_may_fail} {
+        g_image_may_fail = may_fail;
+    }
+    ~ImageMayFailScope() {
+        g_image_may_fail = previous;
+    }
+    ImageMayFailScope(const ImageMayFailScope&) = delete;
+    ImageMayFailScope& operator=(const ImageMayFailScope&) = delete;
+
+private:
+    bool previous;
+};
+
+/// Whether an image no memory is left for gets an unbacked sparse image instead of failing: one
+/// too large to back, or one whose caller cannot do without an image.
+constexpr bool UsesUnbackedFallback(u64 texels, bool may_fail) {
+    return texels > MaxBackedImageTexels || !may_fail;
+}
+
+} // namespace Vulkan
diff --git a/src/video_core/vulkan_common/vulkan_memory_allocator.cpp b/src/video_core/vulkan_common/vulkan_memory_allocator.cpp
index 3a60217..90599c1 100644
--- a/src/video_core/vulkan_common/vulkan_memory_allocator.cpp
+++ b/src/video_core/vulkan_common/vulkan_memory_allocator.cpp
@@ -19,6 +19,7 @@
 #include "common/literals.h"
 #include "common/logging.h"
 #include <ranges>
+#include "video_core/vulkan_common/unbacked_fallback.h"
 #include "video_core/vulkan_common/vma.h"
 #include "video_core/vulkan_common/vulkan_device.h"
 #include "video_core/vulkan_common/vulkan_memory_allocator.h"
@@ -272,6 +273,20 @@ vk::Image MemoryAllocator::CreateImage(const VkImageCreateInfo &ci, bool dedicat
         if (!huge) {
             pressure_events.fetch_add(1, std::memory_order_relaxed);
         }
+        // EDEN_UP_FRITCHII_UNBACKED=1 (zortos293/Lichii#880): an image the texture cache can do
+        // without fails instead (TextureCacheRuntime::SurvivesImageRefusal leaves it out until the
+        // collector freed memory). Without the switch g_image_may_fail is never set.
+        if (!UsesUnbackedFallback(texels, g_image_may_fail)) {
+            static u32 failed_logged{};
+            if (failed_logged++ < 32) {
+                LOG_WARNING(Render_Vulkan,
+                            "Image {}x{}x{} ({} levels, {} layers, format {}) does not fit; left "
+                            "out instead of unbacked (EDEN_UP_FRITCHII_UNBACKED, {} so far)",
+                            ci.extent.width, ci.extent.height, ci.extent.depth, ci.mipLevels,
+                            ci.arrayLayers, static_cast<u32>(ci.format), failed_logged);
+            }
+            throw vk::Exception(VK_ERROR_OUT_OF_DEVICE_MEMORY);
+        }
         // Too big to back at all, e.g. title 1's sparse virtual texture arrays (8192x8192,
         // 68 layers, ~23 GB): on the console only resident tiles have memory. Use an image with
         // nothing bound, so views and copies still work, instead of aborting.
