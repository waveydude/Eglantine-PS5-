@@ -81,6 +82,9 @@ public:
     template <typename Make>
     [[nodiscard]] bool SurvivesImageRefusal(Make&& make) {
         try {
+            // EDEN_UP_FRITCHII_UNBACKED=1 (Lichii #880): while this image is made, one that does
