Subject: [PATCH] Pipeline builds take turns while memory is short (EDEN_PIPELINE_MEMORY_GATE_MIB)

On the way to Ocarina of Time's Castle Town eight builder threads and the GPU thread built
pipelines at once; the heap's blocks of their own went from 351 to 1168 MiB in seconds and the
GPU thread's next allocation failed with the pool empty (crash-20261110-185626, base PS5 13.60).
With EDEN_PIPELINE_MEMORY_GATE_MIB=<n>, a graphics or compute pipeline build that starts while the
pool's largest free block is under n MiB waits until no other build is running, the pool is over
the mark again, or EDEN_PIPELINE_MEMORY_GATE_MS (2000) has passed; it then goes ahead, never
refused. Off unless set. Same idea as Vampinity's EDEN_UP_HEAP_WAIT_MS, written separately.
Host test: tools/test-pipeline-memory-gate.cpp (frontend repo).

---
diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -42,6 +42,7 @@
 #include "shader_recompiler/ir_opt/compose_guard.h"
 #include "shader_recompiler/ir_opt/oot_visual_workaround.h"
 #include "shader_recompiler/program_header.h"
+#include "video_core/renderer_vulkan/pipeline_memory_gate.h"
 #include "video_core/engines/kepler_compute.h"
 #include "video_core/engines/maxwell_3d.h"
 #include <unordered_set>
@@ -405,6 +406,54 @@
 // VK_ERROR_OUT_OF_HOST_MEMORY, Ocarina on 13.60 with the shared pool empty, crash-20261109-121818).
 // Like a std::bad_alloc here: this pipeline fails, its draws are dropped, and the session goes on.
 // Any other Vulkan error still ends the session.
+// headless/performance.cpp: the largest free block of the pool the CPU shares with the GPU, in
+// bytes, 0 when unknown. Weak: without it the gate below never waits.
+extern "C" unsigned long long eden_pool_largest_free(void) __attribute__((weak));
+
+// EDEN_PIPELINE_MEMORY_GATE_MIB=<n> (off unless set): while the pool's largest free block is under
+// n MiB, pipeline builds take turns (pipeline_memory_gate.h). EDEN_PIPELINE_MEMORY_GATE_MS=<ms>
+// (default 2000): the longest one waits before it goes ahead anyway.
+PipelineMemoryGate::Counters pipeline_gate_counters;
+std::uint64_t PipelineGateFree() {
+    return eden_pool_largest_free ? eden_pool_largest_free() : 0;
+}
+struct PipelineGateSettings {
+    std::uint64_t mark{};
+    std::chrono::microseconds limit{};
+};
+const PipelineGateSettings& PipelineGate() {
+    static const PipelineGateSettings settings = [] {
+        PipelineGateSettings result{};
+        if (const char* const mib = std::getenv("EDEN_PIPELINE_MEMORY_GATE_MIB")) {
+            result.mark = std::strtoull(mib, nullptr, 10) << 20;
+        }
+        const char* const ms = std::getenv("EDEN_PIPELINE_MEMORY_GATE_MS");
+        result.limit = std::chrono::milliseconds{ms != nullptr ? std::strtoull(ms, nullptr, 10) : 2000ULL};
+        if (result.mark != 0) {
+            LOG_INFO(Render_Vulkan, "EDEN_PIPELINE_MEMORY_GATE: builds take turns under {} MiB free, "
+                                    "waiting at most {} ms",
+                     result.mark >> 20, result.limit.count() / 1000);
+        }
+        return result;
+    }();
+    return settings;
+}
+// A line when the waits grew by 32 since the last one (and at the first): how many builds waited,
+// for how long in all, and how many went ahead at the limit.
+void ReportPipelineGate() {
+    static std::atomic<std::uint64_t> reported{0};
+    const std::uint64_t waited = pipeline_gate_counters.waited.load(std::memory_order_relaxed);
+    std::uint64_t last = reported.load(std::memory_order_relaxed);
+    if (waited == 0 || (last != 0 && waited < last + 32) ||
+        !reported.compare_exchange_strong(last, waited, std::memory_order_relaxed)) {
+        return;
+    }
+    LOG_INFO(Render_Vulkan, "EDEN_PIPELINE_MEMORY_GATE: {} of {} builds waited, {} ms in all, {} at the limit",
+             waited, pipeline_gate_counters.builds.load(std::memory_order_relaxed),
+             pipeline_gate_counters.wait_us.load(std::memory_order_relaxed) / 1000,
+             pipeline_gate_counters.timeouts.load(std::memory_order_relaxed));
+}
+
 bool SurviveDriverOutOfMemory(const vk::Exception& exception, const char* where) {
     const VkResult result = exception.GetResult();
     if (result != VK_ERROR_OUT_OF_HOST_MEMORY && result != VK_ERROR_OUT_OF_DEVICE_MEMORY) {
@@ -1985,6 +2034,9 @@
     ShaderPools& pools, const GraphicsPipelineCacheKey& key,
     std::span<Shader::Environment* const> envs, PipelineStatistics* statistics,
     bool build_in_parallel, ShaderPrep::Stages* kept_out) try {
+    const PipelineMemoryGate::Gate memory_gate{pipeline_gate_counters, &PipelineGateFree, PipelineGate().mark,
+                                               PipelineGate().limit};
+    ReportPipelineGate();
     auto hash = key.Hash();
     LOG_DEBUG(Render_Vulkan, "{:#016x}", hash);
     size_t env_index{0};
@@ -2401,6 +2453,9 @@
 std::unique_ptr<ComputePipeline> PipelineCache::CreateComputePipeline(
     ShaderPools& pools, const ComputePipelineCacheKey& key, Shader::Environment& env,
     PipelineStatistics* statistics, bool build_in_parallel) try {
+    const PipelineMemoryGate::Gate memory_gate{pipeline_gate_counters, &PipelineGateFree, PipelineGate().mark,
+                                               PipelineGate().limit};
+    ReportPipelineGate();
     auto hash = key.Hash();
     if (device.HasBrokenCompute()) {
         LOG_ERROR(Render_Vulkan, "Skipping {:#016x}", hash);
diff --git a/src/video_core/renderer_vulkan/pipeline_memory_gate.h b/src/video_core/renderer_vulkan/pipeline_memory_gate.h
new file mode 100644
--- /dev/null
+++ b/src/video_core/renderer_vulkan/pipeline_memory_gate.h
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// EglantinePS5: pipeline builds take turns while memory is short (EDEN_PIPELINE_MEMORY_GATE_MIB).
+//
+// Building a pipeline translates its shaders and runs the driver's compiler, and both take their
+// working memory from the pool the CPU and the GPU share. On the way to Ocarina of Time's Castle
+// Town eight builder threads and the GPU thread built at once, the heap's blocks of their own went
+// from 351 to 1168 MiB in seconds, and the GPU thread's next allocation failed with the pool empty
+// (crash-20261110-185626). With the gate, a build that starts while the largest free block of the
+// pool is under the mark waits until no other build is running, or the pool is over the mark
+// again, or its wait reaches the limit (then it goes ahead: a build is never refused here). Over
+// the mark nothing changes. Every build leaves the gate when it ends, by any path.
+//
+// Header only and free of Vulkan, so tools/test-pipeline-memory-gate.cpp tests it on any host.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+namespace Vulkan::PipelineMemoryGate {
+
+struct Counters {
+    std::atomic<std::uint64_t> builds{0};   // builds that passed the gate
+    std::atomic<std::uint64_t> waited{0};   // of them, builds that had to wait
+    std::atomic<std::uint64_t> wait_us{0};  // total time they waited
+    std::atomic<std::uint64_t> timeouts{0}; // waits that reached the limit
+    std::atomic<std::uint32_t> running{0};  // builds inside the gate now
+};
+
+// free_bytes(): the pool's largest free block in bytes, 0 when unknown (the gate then never waits).
+// mark: under this, builds take turns. limit: the longest a build waits. poll: between looks.
+template <typename FreeBytes>
+class Gate {
+public:
+    Gate(Counters& counters, FreeBytes free_bytes, std::uint64_t mark, std::chrono::microseconds limit,
+         std::chrono::microseconds poll = std::chrono::microseconds{2000})
+        : counters_{counters} {
+        if (mark == 0) {
+            entered_ = false;
+            return;
+        }
+        const auto start = std::chrono::steady_clock::now();
+        bool waited = false;
+        for (;;) {
+            std::uint32_t running = counters_.running.load(std::memory_order_acquire);
+            const std::uint64_t free = free_bytes();
+            if (free == 0 || free >= mark || running == 0) {
+                if (counters_.running.compare_exchange_weak(running, running + 1, std::memory_order_acq_rel)) {
+                    break;
+                }
+                continue;
+            }
+            waited = true;
+            if (std::chrono::steady_clock::now() - start >= limit) {
+                counters_.running.fetch_add(1, std::memory_order_acq_rel);
+                counters_.timeouts.fetch_add(1, std::memory_order_relaxed);
+                break;
+            }
+            std::this_thread::sleep_for(poll);
+        }
+        counters_.builds.fetch_add(1, std::memory_order_relaxed);
+        if (waited) {
+            counters_.waited.fetch_add(1, std::memory_order_relaxed);
+            counters_.wait_us.fetch_add(static_cast<std::uint64_t>(
+                                            std::chrono::duration_cast<std::chrono::microseconds>(
+                                                std::chrono::steady_clock::now() - start)
+                                                .count()),
+                                        std::memory_order_relaxed);
+        }
+    }
+    ~Gate() {
+        if (entered_) counters_.running.fetch_sub(1, std::memory_order_acq_rel);
+    }
+    Gate(const Gate&) = delete;
+    Gate& operator=(const Gate&) = delete;
+
+private:
+    Counters& counters_;
+    bool entered_ = true;
+};
+
+} // namespace Vulkan::PipelineMemoryGate
