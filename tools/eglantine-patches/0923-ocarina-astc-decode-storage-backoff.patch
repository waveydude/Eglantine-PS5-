 void TextureCacheRuntime::TickFrame() {
+    ++runtime_frame_index;
     static constexpr u32 MAX_UNUSED_SCRATCH_FRAMES = 60;
     // EDEN_NX2_CLEAN_BY_TIME=1: the unused-frame counters below (decode images, copy buffers, MSAA
     // scratch images) advance by the 60 fps frames this frame took, up to 8, instead of by 1: at
@@ -5390,6 +5391,24 @@
     astc_decoder_pass->AssembleLayers(image, map, swizzles, layers);
 }
 
+void TextureCacheRuntime::NoteAstcDecodeStorageRefusal() noexcept {
+    ++astc_decode_fail_count;
+    const u64 backoff_frames =
+        std::min<u64>(u64{1} << std::min<u32>(astc_decode_fail_count + 2, 6), 64);
+    astc_decode_retry_frame = runtime_frame_index + backoff_frames;
+    upload_refused = true;
+    if ((astc_decode_fail_count & (astc_decode_fail_count - 1)) == 0) {
+        LOG_WARNING(Render_Vulkan,
+                    "ASTC decode storage allocation refused ({} times so far): backing off for {} frames",
+                    astc_decode_fail_count, backoff_frames);
+    }
+}
+
+void TextureCacheRuntime::NoteAstcDecodeStorageSuccess() noexcept {
+    astc_decode_fail_count = 0;
+    astc_decode_retry_frame = 0;
+}
