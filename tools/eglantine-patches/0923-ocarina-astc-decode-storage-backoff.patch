Subject: [PATCH] Back off repeated ASTC decode storage allocation failures

--- a/src/video_core/renderer_vulkan/vk_texture_cache.h
+++ b/src/video_core/renderer_vulkan/vk_texture_cache.h
@@ -336,6 +336,18 @@
     /// See TakeUploadRefused.
     bool upload_refused = false;
 
+    /// Backoff for ASTC decode storage image allocations (tex_storage).
+    u64 astc_decode_retry_frame = 0;
+    u32 astc_decode_fail_count = 0;
+    u64 runtime_frame_index = 0;
+
+    [[nodiscard]] bool CanAllocateAstcDecodeStorage() const noexcept {
+        return runtime_frame_index >= astc_decode_retry_frame;
+    }
+
+    void NoteAstcDecodeStorageRefusal() noexcept;
+    void NoteAstcDecodeStorageSuccess() noexcept;
+
     /// Temporary decode images, reusable once the GPU is past `tick`.
     struct PendingTranscode {
         u64 tick;
