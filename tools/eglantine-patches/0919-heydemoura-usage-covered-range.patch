Subject: [PATCH] Skip already covered buffer usage ranges

Adapt Heydemoura PR #100 (0077) to T120’s Fritchii page-run tracker. Opt in with EDEN_NX2_USAGE_COVERED_RANGE=1.

diff --git a/src/video_core/buffer_cache/usage_tracker.h b/src/video_core/buffer_cache/usage_tracker.h
index 4faf809..bdb0e22 100644
--- a/src/video_core/buffer_cache/usage_tracker.h
+++ b/src/video_core/buffer_cache/usage_tracker.h
@@ -40,9 +40,15 @@ public:
         recent.fill({~u64{0}, 0});
         full_begin = 0;
         full_end = 0;
+        covered_begin = covered_end = 0;
     }
 
     void Track(u64 offset, u64 size) noexcept {
+        static const bool skip_covered = Common::PeSwitch("EDEN_NX2_USAGE_COVERED_RANGE");
+        if (skip_covered && offset >= covered_begin && offset <= covered_end &&
+            size <= covered_end - offset) {
+            return;
+        }
         // Tracking is idempotent until Reset: skip ranges tracked just before. Draws bind the
         // same (often multi-megabyte) storage buffers again and again, and each Track wrote a
         // word per 4 KiB of the range.
@@ -72,6 +78,10 @@ public:
         const size_t offset_end = offset + size;
         const size_t offset_end_page_aligned = Common::AlignDown(offset_end, BUFFER_PAGE_BYTES);
         TrackPage(page_end, offset_end_page_aligned, offset_end - offset_end_page_aligned);
+        if (skip_covered && size > covered_end - covered_begin) {
+            covered_begin = offset;
+            covered_end = offset_end;
+        }
     }
 
     [[nodiscard]] bool IsUsed(u64 offset, u64 size) const noexcept {
@@ -178,6 +188,9 @@ private:
     std::array<std::pair<u64, u64>, 4> recent{{{~u64{0}, 0}, {~u64{0}, 0}, {~u64{0}, 0}, {~u64{0}, 0}}};
     size_t recent_cursor{};
     bool tracked{};
+    // Largest byte range fully marked since Reset.
+    u64 covered_begin{};
+    u64 covered_end{};
     /// Pages known to be all ones (FillPages, EDEN_UP_FRITCHII_USAGE_TRACKER).
     size_t full_begin{};
     size_t full_end{};
