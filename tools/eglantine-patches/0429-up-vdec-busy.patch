     // Starts or corrects the movie clock from a frame the client just acquired (m_mutex held).
     // The clock never runs behind a frame the client already shows.
+    // EDEN_UP_MOVIE_CLOCK=1 (Lichii 89fecaa577, #809): a frame acquired ahead of the clock doesn't
+    // move it; the clock starts from the first acquire and runs in real time (restarting as before
+    // after a pause, a loop or a lag over 3 s). Kirby Air Riders takes frames before it shows
+    // them, and following those acquires ran the clock ahead: 563 of 588 frames dropped late.
     void AnchorClock(u64 pts) {
+        static const bool real_time = Common::PeSwitch("EDEN_UP_MOVIE_CLOCK");
         const s64 now = HostTimeUs();
         const s64 offset = now - static_cast<s64>(pts);
         if (!m_clock_offset || now - m_last_acquire > PauseGap || pts < m_last_acquired_pts ||
-            offset < *m_clock_offset || offset - *m_clock_offset > MaxCatchUp) {
+            (!real_time && offset < *m_clock_offset) || offset - *m_clock_offset > MaxCatchUp) {
             m_clock_offset = offset;
         }
         m_last_acquire = now;
