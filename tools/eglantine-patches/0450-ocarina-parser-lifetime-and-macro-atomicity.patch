+// A GPU page table entry that names a device address outside the device address space is stale or
+// corrupt. The read is zero-filled (DeviceMemoryManager::GetPointer refuses it); the first ones are
+// logged with the GPU address, so a descriptor table read from a wild address is visible in the log
+// instead of ending the process (Ocarina, 109 s: SIGSEGV in GPUBack, ReadBlockImpl, 22,368 bytes).
+static void NoteDeviceRangeOutside(GPUVAddr gpu_addr, std::size_t size, std::size_t page_index,
+                                   DAddr dev_addr, std::size_t amount) {
+    if (MaxwellDeviceMemoryManager::InDeviceSpace(dev_addr, amount)) [[likely]] {
+        return;
+    }
+    static std::atomic<u32> reported{};
+    if (reported.fetch_add(1, std::memory_order_relaxed) < 16) {
+        LOG_ERROR(HW_GPU,
+                  "GPU read {:#x}+{:#x}: page {:#x} maps to device address {:#x}, outside the device "
+                  "address space; the bytes read as zero",
+                  u64{gpu_addr}, u64{size}, u64{page_index}, u64{dev_addr});
+    }
+}
