-bool DmaPusher::SplitContinuesHere(const CommandListHeader& header) {
+// The decision whether an entry continues the method the entry before left open, made on the words
+// the parser will run. It used to read guest memory (ReadBlockUnsafe) while Step parsed the submit
+// copy, the flushed read or the list copy: the game refills its command ring, so after a
+// semaphore wait the two could disagree, and an entry that read as a fresh stream in the copy was
+// taken as the method's data, its header fed to a macro as a parameter (Ocarina, 109 s,
+// "Native MME failed: consumed=1/1, parameters=a0040e02", then a render-condition assert and
+// SIGSEGV in GPUBack).
+void DmaPusher::DecideSplitOnWords(const CommandListHeader& header,
+                                   std::span<const CommandHeader> commands) {
+    if (command_resume_offset != 0) {
+        return; // a resumed entry continues its own parse
+    }
+    if (g_nx2_ampere && SplitCheckMode() != 0 &&
+        std::getenv("EDEN_NX2_PARK_SPLIT_METHODS") == nullptr) {
+        // EDEN_NX2_SPLIT_PARSE_CHECK: park only an entry that does not read as the continuation
+        // but does read as a fresh stream (run 162), otherwise continue as before (run 165:
+        // parking every non-adjacent entry hung the first load).
+        const bool parked_here = std::ranges::any_of(parked_methods, [&](const ParkedMethod& p) {
+            return p.resume_address == header.addr;
+        });
+        if (dma_state.method_count != 0 && header.addr != split_method_end &&
+            !SplitContinuesHere(header, commands)) {
+            ResolveSplitMethod(header.addr);
+        } else if (dma_state.method_count == 0 && parked_here) {
+            ResolveSplitMethod(header.addr);
+        }
+    }
+}
