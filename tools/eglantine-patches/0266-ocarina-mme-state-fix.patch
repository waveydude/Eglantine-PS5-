+void KeplerCompute::ParkMacro(u32& out_macro, std::vector<u32>& out_params) {
+    if (front) {
+        out_macro = front->executing_macro.value_or(0);
+        out_params = std::move(front->parameters);
+        front->executing_macro.reset();
+        front->parameters.clear();
+    } else {
+        out_macro = native_executing_macro.value_or(0);
+        out_params = std::move(native_parameters);
+        native_executing_macro.reset();
+        native_parameters.clear();
+    }
+}
+
+void KeplerCompute::ResumeMacro(u32 in_macro, const std::vector<u32>& in_params) {
+    if (front) {
+        if (in_macro != 0) {
+            front->executing_macro = in_macro;
+        } else {
+            front->executing_macro.reset();
+        }
+        front->parameters = in_params;
+    } else {
+        if (in_macro != 0) {
+            native_executing_macro = in_macro;
+        } else {
+            native_executing_macro.reset();
+        }
+        native_parameters = in_params;
+    }
+}
+
 } // namespace Tegra::Engines
