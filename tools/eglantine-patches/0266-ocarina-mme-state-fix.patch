+
+    void Take(u32& active, std::vector<u32>& args, Segments& reads, bool& needs_refresh) {
+        method = std::exchange(active, 0);
+        parameters.swap(args);
+        segments.swap(reads);
+        dirty = std::exchange(needs_refresh, false);
+    }
+
+    void Restore(u32& active, std::vector<u32>& args, Segments& reads, bool& needs_refresh) && {
+        active = method;
+        args = std::move(parameters);
+        reads = std::move(segments);
+        needs_refresh = dirty;
+    }
+};
+
+inline bool ReadsAsCommands(std::span<const u32> words, size_t entry_words, size_t skip) {
+    size_t i = skip;
+    while (i < words.size()) {
+        const u32 header = words[i];
+        const size_t count = (header >> 16) & 0x1fff;
+        switch (header >> 29) {
+        case 1: // Increasing
+        case 3: // NonIncreasing
+        case 5: // IncreaseOnce
+            if (i + 1 + count > entry_words + 64) {
+                return false; // a count no split explains: data read as a header
+            }
+            i += 1 + count;
+            break;
+        case 4: // Inline: the data is in the header
+            ++i;
+            break;
+        default:
+            return false; // IncreasingOld, NonIncreasingOld and the unused modes: ProcessCommands drops them
+        }
+    }
+    return true; // data to the end of the window is a continuation too
+}
+
+inline bool SplitReadsAsContinuation(std::span<const u32> words, std::size_t entry_words,
+                                      u32 pending_words) {
+    return ReadsAsCommands(words, entry_words, pending_words) ||
+           !ReadsAsCommands(words, entry_words, 0);
+}
+
+} // namespace Tegra
