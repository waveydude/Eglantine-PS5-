Subject: [PATCH] Lichii #918 (281477eac7): Log2Ceil(0) returns the smallest bucket instead of wrapping (staging pool lookup 160 GiB past its array on a zero-size request)

diff --git a/src/common/bit_util.h b/src/common/bit_util.h
--- a/src/common/bit_util.h
+++ b/src/common/bit_util.h
@@ -34,9 +34,16 @@ template<typename T>
     return T(MostSignificantBit<T>(value));
 }
 
+/// The exponent of the smallest power of two that is at least value. 0 for 0: a zero-size
+/// request fits the smallest bucket, where Log2Floor(0) would wrap and index far out of range.
+/// Lichii #918 (281477eac7): a zero-size staging request read StagingBufferPool's 64-entry
+/// cache at index 2^32 in TryGetReservedBuffer.
 template<typename T>
     requires std::is_integral_v<T>
 [[nodiscard]] constexpr T Log2Ceil(const T value) {
+    if (value == T(0)) {
+        return T(0);
+    }
     const T log2_f = Log2Floor<T>(value);
     return T(log2_f + T((value ^ (T(1ULL) << log2_f)) != T(0ULL)));
 }
