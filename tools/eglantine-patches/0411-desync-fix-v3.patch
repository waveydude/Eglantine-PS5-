-        }
-        return clash;
-    }();
+    const bool parser_switches = DesyncFixParserClash(SplitCheckMode());
     constexpr u64 OcarinaOfTimeProgramId = 0x0400486024DEC000ULL;
     const bool title = Tegra::g_nx2_ampere.load(std::memory_order_relaxed) &&
                        system.GetApplicationProcessProgramID() == OcarinaOfTimeProgramId;
     if (static std::atomic<bool> reported{}; !title && !reported.exchange(true)) {
-        LOG_WARNING(HW_GPU, "EDEN_NX2_DESYNC_FIX=1 stays off: not Ocarina of Time on Switch 2 "
+        LOG_WARNING(HW_GPU, "EDEN_NX2_DESYNC_FIX={} stays off: not Ocarina of Time on Switch 2 "
                             "(program {:#018x})",
-                    system.GetApplicationProcessProgramID());
+                    DesyncFixMode(), system.GetApplicationProcessProgramID());
+    }
+    if (static std::atomic<bool> reported{};
+        title && !parser_switches && !reported.exchange(true)) {
+        LOG_WARNING(HW_GPU, "EDEN_NX2_DESYNC_FIX={} active: Ocarina of Time on Switch 2, first "
+                            "resume after a suspension",
