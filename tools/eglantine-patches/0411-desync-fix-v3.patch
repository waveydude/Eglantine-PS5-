 }
 } // Anonymous namespace
 
-// EDEN_NX2_DESYNC_FIX=1 (exact "1"): see DmaPusher::RefreshSnapshot. Only for Ocarina of Time on
-// Switch 2: Mario Kart World (after a present) and Pokopia submit lists before they write them
-// (upstream 256b1dc346), so a submit copy there can be an older frame that walks clean, and keeping
-// it would bring back their wrong-frame and fence-hang bugs. The walk matches the parser only with
-// the junk guard and split-method parking off, so the fix stays off with any of them set.
+// EDEN_NX2_DESYNC_FIX=1 (exact "1"): see DmaPusher::RefreshSnapshot. =2: the same, except lists
+// copied during a suspension take memory as T63 (judged for the log only). Read once.
+int DmaPusher::DesyncFixMode() {
+    static const int mode = [] {
+        if (Common::PeSwitch("EDEN_NX2_DESYNC_FIX")) {
+            return 1;
+        }
+        const char* value = std::getenv("EDEN_NX2_DESYNC_FIX");
+        return value != nullptr && value[0] == '2' && value[1] == '\0' ? 2 : 0;
+    }();
+    return mode;
+}
+
+namespace {
+// The walk matches the parser only with the junk guard, split-method parking and the split parse
+// check off: with any of them set the fix stays off (logged once, from the first DmaPusher).
+bool DesyncFixParserClash(int split_check_mode) {
+    static const bool clash = [split_check_mode] {
+        const char* guard = std::getenv("EDEN_NX2_JUNK_GUARD");
+        const bool clash_now = (guard != nullptr && guard[0] == '1') ||
+                               std::getenv("EDEN_NX2_PARK_SPLIT_METHODS") != nullptr ||
+                               split_check_mode != 0;
+        if (clash_now) {
+            LOG_WARNING(HW_GPU, "EDEN_NX2_DESYNC_FIX={} stays off: JUNK_GUARD, PARK_SPLIT_METHODS "
+                                "or SPLIT_PARSE_CHECK is set, and its walk doesn't model them",
+                        DmaPusher::DesyncFixMode());
+        }
+        return clash_now;
+    }();
+    return clash;
+}
+} // Anonymous namespace
+
+// Only for Ocarina of Time on Switch 2: Mario Kart World (after a present) and Pokopia submit
+// lists before they write them (upstream 256b1dc346), so a submit copy there can be an older frame
+// that walks clean, and keeping it would bring back their wrong-frame and fence-hang bugs.
