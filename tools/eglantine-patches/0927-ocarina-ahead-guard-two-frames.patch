+/// EDEN_UP_AHEAD_GUARD_SLOTS=2 (with =1, =2 or =3; default 1): the guard covers two frames in
+/// flight, each in a slot of its own, for a present that returns before the frame two back is
+/// done (EDEN_UP_AHEAD_TWO). With one slot, a present that found the guard still up for the
+/// frame before left its own frame unguarded: GrowingBlackBeans' two-frames-in-flight runs
+/// (12 Nov, base PS5) found it so at 9-15% of presents, and those runs flickered.
+///
+/// With two slots:
+///  - each slot has its own guarded pages, fence and trap (+1 on the cached count per slot), so
+///    a page both frames read is trapped twice and a write to it takes one copy for both;
+///  - a copy belongs to the slots that needed it when it was taken (a page may have two: one
+///    made before the newer frame's present, for the older frame, and one made after it);
+///  - the GPU thread's reads take the copy of the frame the back is recording, which is the
+///    oldest guarded frame it has not passed (BackPassed, run in order after each present's
+///    lists), or failing that the copy of a newer frame, which is older than memory;
+///  - what uploads read from a frame's copies is handed back as guest writes once the back has
+///    passed that frame (not at its fence: the back records the next frame before the fence),
+///    and =3 holds a write only until the back has passed the newest frame guarded when it was
+///    made;
+///  - a slot is lifted at its own fence, as the one slot is.
+/// With one slot everything is as before.
+inline constexpr u32 MaxSlots = 2;
+
+inline u32 SlotCount() {
+    static const u32 slots = [] {
+        const char* value = std::getenv("EDEN_UP_AHEAD_GUARD_SLOTS");
+        const u32 parsed = value != nullptr && value[0] == '2' && value[1] == '\0' ? 2U : 1U;
+        if (parsed == 2 && Mode() != 0) {
+            LOG_INFO(HW_GPU, "EDEN_UP_AHEAD_GUARD_SLOTS=2: the guard covers two frames in flight");
+        }
+        return parsed;
+    }();
+    return slots;
+}
