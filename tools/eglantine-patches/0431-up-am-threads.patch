         "appletAE", std::make_shared<IAllSystemAppletProxiesService>(system, window_system));
     server_manager->RegisterNamedService(
         "appletOE", std::make_shared<IApplicationProxyService>(system, window_system));
+    // EDEN_UP_AM_THREADS=1 (Lichii 72e9429daf, #659): two more host threads for this server. The
+    // Switch 2 graphics system (nx2:gsv, from ISelfController) and every session it hands out (vi2,
+    // vdecsvc, syncpt, gpu, nvsrv) are served here. vi2's present holds its thread until the next
+    // vblank (PaceToVblank, ~12-14 ms of each 16.7 ms frame), and with one thread every movie
+    // decoder call queued behind it (Lichii: Ocarina's title movie 10 s behind its audio, 4 s with
+    // the threads). Each service keeps its own lock (ServiceFrameworkBase::LockService).
+    if (Common::PeSwitch("EDEN_UP_AM_THREADS")) {
+        LOG_INFO(Service_AM, "EDEN_UP_AM_THREADS: serving AM and nx2:gsv on 3 host threads");
+        server_manager->StartAdditionalHostThreads("am", 2);
+    }
     ServerManager::RunServer(std::move(server_manager));
 }
 
