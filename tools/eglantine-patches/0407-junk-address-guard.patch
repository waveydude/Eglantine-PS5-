Subject: [PATCH] texture cache: refuse an image at a GPU address outside the address space (pond desync crash at ~87 s, IsContinuousRange)

diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
index d2231c2..d614730 100644
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -3500,6 +3500,19 @@ ImageId TextureCache<P>::JoinImages(const ImageInfo& info, GPUVAddr gpu_addr, DA
     join_bad_overlap_ids.clear();
     join_copies_to_do.clear();
     join_alias_indices.clear();
+    if (size_bytes != 0 && !gpu_memory->IsWithinGPUAddressRange(gpu_addr)) [[unlikely]] {
+        // A GPU address past the address space: junk render-target registers (zeta/rt address
+        // and size written by method data after a pushbuffer desync, the pond test at ~87 s).
+        // IsContinuousRange below would index the page-state table with it (GetEntry has no bounds
+        // check) and fault on GPUBack: eboot+0x14f9126 T61 run293/299/306, eboot+0x14ef376 T49
+        // run195. Refused like an image with no memory: callers already handle ImageId{}.
+        static u32 out_of_range{};
+        if (out_of_range++ < 16) {
+            LOG_ERROR(HW_GPU, "Image at {:#x} ({}x{}, {} bytes) is outside the GPU address space: left out",
+                      gpu_addr, new_info.size.width, new_info.size.height, size_bytes);
+        }
+        return ImageId{};
+    }
     const bool this_is_linear = info.type == ImageType::Linear;
     const auto region_check = [&](ImageId overlap_id, ImageBase& overlap) {
         if (True(overlap.flags & ImageFlagBits::Remapped)) {
