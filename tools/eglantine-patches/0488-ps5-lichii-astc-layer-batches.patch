+    // A single scratch image and BC buffer are reused for the layer batches.
+    static const bool batch_layers = Common::PeSwitch("EDEN_NX2_TRANSCODE_BATCH_LAYERS");
+    u64 layer_decode_bytes = 0;
+    for (u32 level = 0; level < levels; ++level) {
+        layer_decode_bytes += u64{(std::max)(width >> level, 1U)} *
+                              (std::max)(height >> level, 1U) * 4;
     }
+    const bool aligned_layers = info.layer_stride % device.GetStorageBufferAlignment() == 0;
+    const u32 batch = batch_layers && layers > 1 && info.layer_stride != 0 && aligned_layers &&
+                              info.num_samples == 1 && layer_decode_bytes != 0 &&
+                              False(image.flags & ImageFlagBits::Rescaled)
+                          ? static_cast<u32>(std::clamp<u64>((u64{64} << 20) / layer_decode_bytes,
+                                                            1, layers))
+                          : layers;
+    const bool split = batch < layers;
     static const bool bounded = Common::PeSwitch("EDEN_PE_TRANSCODE_BOUND");
     if (bounded) {
         const auto bytes = [](const PendingTranscode& t) {
@@ -5225,11 +5240,7 @@
             }
