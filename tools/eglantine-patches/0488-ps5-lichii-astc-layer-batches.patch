+    std::optional<StagingBufferRef> output;
+    VideoCommon::ImageInfo batch_info = info;
+    for (u32 first = 0; first < layers; first += batch) {
+        const u32 count = (std::min)(batch, layers - first);
+        boost::container::small_vector<VideoCommon::BufferImageCopy, 16> copies;
+        u64 total = 0;
+        for (u32 level = 0; level < levels; ++level) {
+            const u32 level_width = (std::max)(width >> level, 1U);
+            const u32 level_height = (std::max)(height >> level, 1U);
+            const u32 blocks_x = Common::DivCeil(level_width, 4U);
+            const u32 blocks_y = Common::DivCeil(level_height, 4U);
+            const u64 size = u64{blocks_x} * blocks_y * count * block_bytes;
+            copies.push_back({
+                .buffer_offset = total,
+                .buffer_size = size,
+                .buffer_row_length = blocks_x * 4,
+                .buffer_image_height = blocks_y * 4,
+                .image_subresource{
+                    .base_level = static_cast<s32>(level),
+                    .base_layer = static_cast<s32>(first),
+                    .num_layers = static_cast<s32>(count),
+                },
+                .image_offset{0, 0, 0},
+                .image_extent{level_width, level_height, 1},
+            });
+            total += size;
+        }
+        if (split && first == 0) {
+            // Acquire the one output buffer before recording a partial upload.
+            output = staging_buffer_pool.TryRequest(total, MemoryUsage::DeviceLocal);
+            if (!output) {
+                upload_refused = true;
+                return;
+            }
+            // UploadMemory transitions only its copy range. Initialize all layers before any
+            // partial copy so subsequent batches start from GENERAL as UploadMemory expects.
+            TransitionImageLayout(image);
+            LOG_INFO(Render_Vulkan,
+                     "ASTC transcode split {}x{}x{} ({} mips) into {} layers per batch, "
+                     "decode scratch {} -> {} MiB, BC staging {} MiB per batch",
+                     width, height, layers, levels, batch, (layer_decode_bytes * layers) >> 20,
+                     (layer_decode_bytes * batch) >> 20, total >> 20);
+        } else if (first != 0) {
+            // The previous batch encoded from the image and copied from the BC buffer.
+            // Order both reads before the next batch overwrites that scratch.
+            scheduler.Record([](vk::CommandBuffer cmdbuf) {
+                const VkMemoryBarrier barrier{
+                    .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                    .pNext = nullptr,
+                    .srcAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT,
+                    .dstAccessMask = VK_ACCESS_SHADER_WRITE_BIT,
+                };
+                cmdbuf.PipelineBarrier(
+                    VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                    VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, barrier);
+            });
+        }
+
+        batch_info.resources.layers = static_cast<s32>(count);
+        StagingBufferRef input = map;
+        const size_t layer_offset = size_t{first} * info.layer_stride;
+        input.offset += layer_offset;
+        const size_t input_size = split
+                                      ? (std::min)(size_t{count} * info.layer_stride,
+                                                   size_t{image.guest_size_bytes} - layer_offset)
+                                      : image.guest_size_bytes;
+        const u64 decode_tick = scheduler.CurrentTick();
+        astc_decoder_pass->AssembleInto(
+            batch_info, 0, input_size,
+            ASTCDecoderPass::Target{
+                .image = *pending.image,
+                .aspect_mask = VK_IMAGE_ASPECT_COLOR_BIT,
+                .initialized = first != 0,
+                .level_view = [&pending](s32 level) { return *pending.views[level]; },
+                .wait = true,
+            },
+            input, swizzles);
+        if (split) {
+            // AssembleInto may submit. Keep both staging buffers busy until the last batch.
+            staging_buffer_pool.CarryTick(decode_tick, scheduler.CurrentTick());
+        }
