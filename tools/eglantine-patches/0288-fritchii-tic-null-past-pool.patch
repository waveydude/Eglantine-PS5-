From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EglantinePS5 <noreply@eglantineps5.local>
Date: Sun, 8 Nov 2026 12:30:00 +0100
Subject: [PATCH] EDEN_NX2_TIC_NULL_PAST_POOL=1: a texture handle past the descriptor pool compiles as a null 2D texture

Off unless set. Port of the shader_environment.cpp hunk of Frizti/Fritchii 5d11ac7216
(fritchii-v4 "AMD: out-of-range texture handles", zortos293/Lichii#679 from the CheezerWheezer
fork survey by conongnang, chuppatricky, sharkiix, Erick, persluffy-cl, ne1i and
EtienneDefranc). Past the pool the bytes are not a descriptor: reading them gave the shader a
random texture type and format (garbage-format asserts, then crashes and device losses on AMD
in Ocarina of Time). At draw time the texture cache binds the null view for such an index
(VisitImageView), so the shader is compiled for what that view is: a plain 2D RGBA8 texture.
The first 16 cases are logged. Unset: the assert and the read past the pool, as before.
---
diff --git a/src/video_core/shader_environment.cpp b/src/video_core/shader_environment.cpp
index 4fed7db..bd058c7 100644
--- a/src/video_core/shader_environment.cpp
+++ b/src/video_core/shader_environment.cpp
@@ -6,6 +6,7 @@
 
 #include <algorithm>
 #include <array>
+#include <atomic>
 #include <chrono>
 #include <cstdlib>
 #include <thread>
@@ -397,9 +398,36 @@ Tegra::Texture::TICEntry GenericEnvironment::ReadTextureInfo(GPUVAddr tic_addr,
     const auto handle{Tegra::Texture::TexturePair(raw, via_header_index)};
     const u32 index{Tegra::Texture::TextureHeaderIndex(handle.first, tic_limit,
                                                        gpu_memory->UsesNativeTiling())};
+    // EDEN_NX2_TIC_NULL_PAST_POOL=1 (Frizti/Fritchii 5d11ac7216, zortos293/Lichii#679 "out-of-
+    // range texture handles"): past the pool, the bytes are not a descriptor: reading them gave
+    // the shader a random texture type and format (garbage-format asserts, then crashes and
+    // device losses on AMD in Ocarina of Time). At draw time the texture cache binds the null
+    // view for such an index (VisitImageView), so compile for what that view is: a plain 2D
+    // RGBA8 texture. Unset: the assert and the read past the pool, as before.
+    static const bool null_past_pool = [] {
+        const char* const value = std::getenv("EDEN_NX2_TIC_NULL_PAST_POOL");
+        return value != nullptr && value[0] != '0';
+    }();
+    Tegra::Texture::TICEntry entry;
+    if (null_past_pool && index > tic_limit) {
+        static std::atomic<u32> warnings{};
+        if (warnings.fetch_add(1, std::memory_order_relaxed) < 16) {
+            LOG_WARNING(HW_GPU, "Texture handle {:#x} indexes past the descriptor pool "
+                                "(index {} > limit {}); using a null 2D texture",
+                        raw, index, tic_limit);
+        }
+        entry.raw.fill(0);
+        entry.format.Assign(Tegra::Texture::TextureFormat::A8B8G8R8);
+        entry.r_type.Assign(Tegra::Texture::ComponentType::UNORM);
+        entry.g_type.Assign(Tegra::Texture::ComponentType::UNORM);
+        entry.b_type.Assign(Tegra::Texture::ComponentType::UNORM);
+        entry.a_type.Assign(Tegra::Texture::ComponentType::UNORM);
+        entry.texture_type.Assign(Tegra::Texture::TextureType::Texture2D);
+        entry.normalized_coords.Assign(1);
+        return entry;
+    }
     ASSERT(index <= tic_limit);
     const GPUVAddr descriptor_addr{tic_addr + index * sizeof(Tegra::Texture::TICEntry)};
-    Tegra::Texture::TICEntry entry;
     gpu_memory->ReadBlock(descriptor_addr, &entry, sizeof(entry));
     return entry;
 }
