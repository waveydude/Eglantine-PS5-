+static bool RangeWalkAheadEnabled() {
+    static const bool enabled = Common::PeSwitch("EDEN_NX2_PAGE_RANGE_WALK_AHEAD");
+    return enabled;
+}
+
+void MemoryManager::FinishMapChange(GPUVAddr begin, GPUVAddr end) {
+    std::scoped_lock lock{map_log_guard};
+    const u64 next = map_serial.load(std::memory_order_relaxed) + 1;
+    map_log[next % map_log.size()] = {begin, end};
+    map_serial.store(next, std::memory_order_release);
+}
+
+bool MemoryManager::MapChangedSince(u64 since, u64 serial, GPUVAddr begin, GPUVAddr end) const {
+    if (serial - since > map_log.size()) {
+        return true;
+    }
+    std::scoped_lock lock{map_log_guard};
+    if (map_serial.load(std::memory_order_relaxed) != serial) {
+        return true;
+    }
+    for (u64 change = since; change != serial;) {
+        const auto& [changed_begin, changed_end] = map_log[++change % map_log.size()];
+        // A map that starts exactly where the walk stopped can extend the answer.
+        if (changed_begin <= end && changed_end >= begin) {
+            return true;
+        }
+    }
+    return false;
+}
