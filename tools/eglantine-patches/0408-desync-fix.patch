+
+void DmaPusher::ReportRefreshCheck(const RefreshCheck& check) const {
+    if (check.differing == 0 || !RefreshCheckEventLogged(check.event)) {
+        return;
+    }
+    const std::string end =
+        check.carry_known ? fmt::format("{}", check.carry) : std::string{"unknown"};
+    const std::string injected =
+        check.injected_carry != 0
+            ? fmt::format("{} words into list +{}", check.injected_carry, check.injected_list)
+            : std::string{"none"};
+    LOG_WARNING(HW_GPU,
+                "Refresh check {}: resume at entry {} word {} with {} words wanted, {} lists, fix "
+                "{}: {} entries differ: {} data only, {} kept (reshaped), {} kept (rest of the "
+                "list), {} would keep (fix off), {} copy broken, {} both broken, {} never "
+                "written, {} not judged; first {}; later queued list on the first reshaped: {}; "
+                "carry into an injected list: {}; carry at the end: {}",
+                check.event, dma_pushbuffer_subindex, command_resume_offset,
+                dma_state.method_count, check.list_index, check.fix ? "on" : "off",
+                check.differing, check.data_only, check.kept, check.kept_for_list,
+                check.would_keep, check.copy_broken, check.both_broken, check.unwritten,
+                check.unchecked, check.first_change,
+                check.later_list.empty() ? std::string{"-"} : check.later_list, injected, end);
+}
+
+std::string DmaPusher::LaterListOverlapping(const CommandList& list, GPUVAddr address,
+                                            u64 bytes) const {
+    // `list` is queued (a refresh after a resume) or not yet (a refresh in Push: none is later).
+    size_t later = 0;
+    bool after = false;
+    for (const CommandList& queued : dma_pushbuffer) {
+        if (&queued == &list) {
+            after = true;
+            continue;
+        }
+        if (!after) {
+            continue;
+        }
+        ++later;
+        for (size_t j = 0; j < queued.command_lists.size(); ++j) {
+            const CommandListHeader& other = queued.command_lists[j];
+            const GPUVAddr other_address = other.addr;
+            const u64 other_bytes = u64{other.size} * sizeof(u32);
+            if (other_address < address + bytes && address < other_address + other_bytes) {
+                return fmt::format("list +{} entry {} of {} at {:#x}+{:#x}", later, j,
+                                   queued.command_lists.size(), other_address, u64{other.size});
+            }
+        }
+    }
+    return after ? fmt::format("none of {} queued after", later) : std::string{"none queued after"};
 }
 
