+
+// How ProcessCommands would walk an entry's words from word `start` with `carry` words of an open
+// method wanted there (the refresh check: EDEN_NX2_DESYNC_FIX and its log). With `other` (the
+// same entry's words from elsewhere), also how many of the walk's header words `other` holds
+// otherwise: an inline header's value is data, its mode, subchannel and method are not. Matches
+// ProcessCommands with EDEN_NX2_JUNK_GUARD, PARK_SPLIT_METHODS and SPLIT_PARSE_CHECK off (the fix
+// stays off with any of them set).
+struct ShapeWalk {
+    u32 end = 0;          ///< Words of a method still wanted at the end (the next entry's carry)
+    u32 headers = 0;      ///< Header words walked
+    u32 header_diffs = 0; ///< Of those, words `other` holds otherwise
+    u32 dropped = 0;      ///< Nonzero words in a mode ProcessCommands drops (data read as a header)
+    u32 zero_headers = 0; ///< Zero header words where `other` holds a nonzero word (unwritten)
+};
+
+ShapeWalk WalkCommandShape(std::span<const CommandHeader> words, size_t start, u32 carry,
+                           std::span<const CommandHeader> other = {}) {
+    ShapeWalk walk;
+    size_t i = (std::min)(start, words.size());
+    const size_t carried = (std::min)(size_t{carry}, words.size() - i);
+    i += carried;
+    carry -= static_cast<u32>(carried);
+    while (i < words.size()) {
+        const CommandHeader header = words[i];
+        ++walk.headers;
+        if (i < other.size()) {
+            const u32 mask = header.mode == SubmissionMode::Inline ? 0xE000FFFFU : ~0U;
+            walk.header_diffs += ((header.argument ^ other[i].argument) & mask) != 0 ? 1 : 0;
+            walk.zero_headers += header.argument == 0 && other[i].argument != 0 ? 1 : 0;
+        }
+        ++i;
+        switch (header.mode) {
+        case SubmissionMode::Increasing:
+        case SubmissionMode::NonIncreasing:
+        case SubmissionMode::IncreaseOnce: {
+            const u32 count = header.method_count;
+            const size_t taken = (std::min)(size_t{count}, words.size() - i);
+            i += taken;
+            carry = count - static_cast<u32>(taken);
+            break;
+        }
+        case SubmissionMode::Inline:
+            break;
+        default:
+            walk.dropped += header.argument != 0 ? 1 : 0;
+            break;
+        }
+    }
+    walk.end = carry;
+    return walk;
+}
+
+// How the refresh check judged an entry whose memory differs from its copy (see RefreshSnapshot).
+enum class RefreshVerdict {
+    DataOnly,    // same header words: memory taken
+    Kept,        // reshaped, the copy walks clean: copy kept (fix on)
+    WouldKeep,   // the same, fix off or gated out: memory taken (as T63)
+    KeptForList, // data words only, after a reshape earlier in the list: copy kept (fix on)
+    CopyBroken,  // reshaped, the copy drops words and memory doesn't: memory taken
+    BothBroken,  // reshaped, both drop words: memory taken (as T63)
+    Unwritten,   // the copy is zeros where memory has commands (submitted before written)
+};
+
+constexpr const char* RefreshVerdictName(RefreshVerdict verdict) {
+    switch (verdict) {
+    case RefreshVerdict::DataOnly:
+        return "data words only, took memory";
+    case RefreshVerdict::Kept:
+        return "reshaped, kept the submit copy (DESYNC_FIX)";
+    case RefreshVerdict::WouldKeep:
+        return "reshaped, took memory (fix off: would keep the copy)";
+    case RefreshVerdict::KeptForList:
+        return "data words only after a reshape in this list, kept the submit copy (DESYNC_FIX)";
+    case RefreshVerdict::CopyBroken:
+        return "reshaped, the copy drops words and memory doesn't, took memory";
+    case RefreshVerdict::BothBroken:
+        return "reshaped, both drop words, took memory (as T63)";
+    case RefreshVerdict::Unwritten:
+        return "copy never written (zeros), took memory";
+    }
+    return "?";
+}
+
+// The refresh check's rule for an entry whose memory differs from its copy from word `start` on,
+// with `carry` words of an open method wanted there (RefreshSnapshot). `list_reshaped`: an entry
+// earlier in the list, from the resume point on, kept its copy for a reshape. Fills both walks.
+RefreshVerdict JudgeRefresh(std::span<const CommandHeader> copy, std::span<const CommandHeader> memory,
+                            size_t start, u32 carry, bool fix, bool list_reshaped,
+                            ShapeWalk& copy_walk, ShapeWalk& memory_walk) {
+    copy_walk = WalkCommandShape(copy, start, carry, memory);
+    memory_walk = WalkCommandShape(memory, start, carry, copy);
+    const bool copy_zeros =
+        std::all_of(copy.begin() + (std::min)(start, copy.size()), copy.end(),
+                    [](CommandHeader word) { return word.argument == 0; });
+    // Zeros where memory has commands: submitted before it was written (upstream 256b1dc346).
+    if (copy_zeros || (copy_walk.zero_headers != 0 && memory_walk.dropped == 0)) {
+        return RefreshVerdict::Unwritten;
+    }
+    const bool reshaped = copy_walk.header_diffs != 0 || memory_walk.header_diffs != 0 ||
+                          copy_walk.end != memory_walk.end;
+    if (!reshaped) {
+        return list_reshaped && fix ? RefreshVerdict::KeptForList : RefreshVerdict::DataOnly;
+    }
+    if (copy_walk.dropped == 0) {
+        return fix ? RefreshVerdict::Kept : RefreshVerdict::WouldKeep;
+    }
+    return memory_walk.dropped == 0 ? RefreshVerdict::CopyBroken : RefreshVerdict::BothBroken;
+}
+
+// Refresh check log budget: per resume a summary line and up to 4 entry lines (reshaped entries
+// first), for the first 512 resumes with a differing entry, then every 256th; entry lines stop
+// at 4096 overall.
+constexpr u64 RefreshCheckEventsLogged = 512;
+constexpr u32 RefreshCheckDetailsPerEvent = 4;
+constexpr u64 RefreshCheckDetailsTotal = 4096;
+std::atomic<u64> refresh_check_events{};
+std::atomic<u64> refresh_check_details{};
+
+bool RefreshCheckEventLogged(u64 event) {
+    return event <= RefreshCheckEventsLogged || (event & 0xff) == 0;
+}
 } // Anonymous namespace
+
+// EDEN_NX2_DESYNC_FIX=1 (exact "1"): see DmaPusher::RefreshSnapshot. Only for Ocarina of Time on
+// Switch 2: Mario Kart World (after a present) and Pokopia submit lists before they write them
+// (upstream 256b1dc346), so a submit copy there can be an older frame that walks clean, and keeping
+// it would bring back their wrong-frame and fence-hang bugs. The walk matches the parser only with
+// the junk guard and split-method parking off, so the fix stays off with any of them set.
+bool DmaPusher::DesyncFixActive() const {
+    static const bool wanted = Common::PeSwitch("EDEN_NX2_DESYNC_FIX");
+    if (!wanted) {
+        return false;
+    }
+    static const bool parser_switches = [] {
+        const char* guard = std::getenv("EDEN_NX2_JUNK_GUARD");
+        const bool clash = (guard != nullptr && guard[0] == '1') ||
+                           std::getenv("EDEN_NX2_PARK_SPLIT_METHODS") != nullptr ||
+                           SplitCheckMode() != 0;
+        if (clash) {
+            LOG_WARNING(HW_GPU, "EDEN_NX2_DESYNC_FIX=1 stays off: JUNK_GUARD, PARK_SPLIT_METHODS "
+                                "or SPLIT_PARSE_CHECK is set, and its walk doesn't model them");
+        }
+        return clash;
+    }();
+    constexpr u64 OcarinaOfTimeProgramId = 0x0400486024DEC000ULL;
+    const bool title = Tegra::g_nx2_ampere.load(std::memory_order_relaxed) &&
+                       system.GetApplicationProcessProgramID() == OcarinaOfTimeProgramId;
+    if (static std::atomic<bool> reported{}; !title && !reported.exchange(true)) {
+        LOG_WARNING(HW_GPU, "EDEN_NX2_DESYNC_FIX=1 stays off: not Ocarina of Time on Switch 2 "
+                            "(program {:#018x})",
+                    system.GetApplicationProcessProgramID());
+    }
+    return !parser_switches && title;
+}
 
