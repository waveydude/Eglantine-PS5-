     std::vector<PendingDownload> uncommitted_downloads;
     std::deque<std::vector<PendingDownload>> committed_downloads;
+
+    /// EDEN_NX2_RT_EVICT_PRESSURE=<frames> (off unless set; PS5_Lichii 0227, Fritchii#34,
+    /// Lichii#1023): a render target the GPU never wrote starts undefined instead of loading the
+    /// guest memory under it, and is queued. While the cache is over its expected size, a queued
+    /// target unused for that many frames is deleted without a download; one still in use is
+    /// checked again, up to 4 times, then counts as lasting.
+    struct TransientTarget {
+        ImageId id;
+        u64 allocation_tick;
+        u64 check_tick;
+        u32 survived;
+    };
+    std::deque<TransientTarget> transient_targets;
+    u64 transient_evictions{};
+    u64 transient_evicted_bytes{};
+    u64 logged_transient_evictions{};
+    [[nodiscard]] static u64 RtEvictPressureFrames() {
+        static const u64 frames = [] {
+            const char* value = std::getenv("EDEN_NX2_RT_EVICT_PRESSURE");
+            return value != nullptr ? std::strtoull(value, nullptr, 10) : u64{0};
+        }();
+        return frames;
+    }
     std::vector<AsyncBuffer> uncommitted_async_buffers;
     std::deque<std::vector<AsyncBuffer>> async_buffers;
     std::deque<AsyncBuffer> async_buffers_death_ring;
diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -1228,6 +1228,66 @@
         gc_deletes = gc_costly_deletes = gc_download_deletes = async_decodes_queued = 0;
         images_created = images_deleted = 0;
     }
+    if (const u64 rt_evict = RtEvictPressureFrames();
+        rt_evict != 0 && total_used_memory > expected_memory) {
+        const auto queued = [](ImageId image_id, const auto& downloads) {
+            return std::ranges::any_of(downloads, [image_id](const auto& download) {
+                return download.is_swizzle && download.object_id == image_id;
+            });
+        };
+        for (size_t budget = transient_targets.size(); budget != 0 && !transient_targets.empty();
+             --budget) {
+            TransientTarget entry = transient_targets.front();
+            if (frame_tick - entry.check_tick < rt_evict) {
+                break;
+            }
+            transient_targets.pop_front();
+            if (!slot_images.contains(entry.id)) {
+                continue;
+            }
+            Image& image = slot_images[entry.id];
+            if (image.allocation_tick != entry.allocation_tick ||
+                False(image.flags & ImageFlagBits::TransientTarget) ||
+                False(image.flags & ImageFlagBits::Registered)) {
+                continue;
+            }
+            const bool bound = std::ranges::any_of(image.image_view_ids, [this](ImageViewId view) {
+                return render_targets.depth_buffer_id == view ||
+                       std::ranges::find(render_targets.color_buffer_ids, view) !=
+                           render_targets.color_buffer_ids.end();
+            });
+            const u64 last_use = image.lru_index != SIZE_MAX ? lru_cache.Tick(image.lru_index) : frame_tick;
+            if (frame_tick - last_use < rt_evict || bound ||
+                True(image.flags & ImageFlagBits::IsDecoding) ||
+                queued(entry.id, uncommitted_downloads) ||
+                std::ranges::any_of(committed_downloads,
+                                    [&](const auto& downloads) { return queued(entry.id, downloads); })) {
+                if (++entry.survived < 4) {
+                    entry.check_tick = frame_tick;
+                    transient_targets.push_back(entry);
+                } else {
+                    image.flags &= ~ImageFlagBits::TransientTarget;
+                }
+                continue;
+            }
+            transient_evicted_bytes += image.unswizzled_size_bytes;
+            MarkStale(image);
+            if (True(image.flags & ImageFlagBits::Tracked)) {
+                UntrackImage(image, entry.id);
+            }
+            UnregisterImage(entry.id);
+            DeleteImage(entry.id, false);
+            ++transient_evictions;
+        }
+    } else if (transient_targets.size() > 8192) {
+        transient_targets.erase(transient_targets.begin(),
+                                transient_targets.begin() + (transient_targets.size() - 8192));
+    }
+    if (frame_tick % 600 == 0 && transient_evictions != logged_transient_evictions) {
+        LOG_INFO(HW_GPU, "RT evict: {} unused fresh render targets deleted early so far ({} MiB), {} waiting",
+                 transient_evictions, transient_evicted_bytes >> 20, transient_targets.size());
+        logged_transient_evictions = transient_evictions;
+    }
     // EDEN_UP_FRITCHII_CHURN=1 (Fritchii dcbd696438): what the caches made and destroyed.
     if (Churn::Enabled() && frame_tick % 600 == 0) {
         const auto churn = Churn::Take();
@@ -5497,6 +5557,21 @@
         return ImageViewId{};
