 inline constexpr unsigned kSteerLostLooks = 4;  // looks without Link's marker before the stick is let go
+// EDEN_TEST_STEER_BLIND_LOOKS=<n> (1..240, digits only; unset or anything else: kSteerLostLooks): how many
+// looks without the marker the stick keeps its last direction before Link stands. 17 Nov 2026: a Peahat
+// crosses the field route; when it hits Link the marker is lost, the stick was let go after 4 looks (2 s),
+// and Link stood under it for 50-97 s in 11 of 36 runs. Running on carries him past it.
+inline unsigned SteerLostLooks() {
+    static const unsigned looks = [] {
+        const char* v = std::getenv("EDEN_TEST_STEER_BLIND_LOOKS");
+        if (v == nullptr || *v == '\0') return kSteerLostLooks;
+        unsigned n = 0;
+        for (const char* c = v; *c; ++c) {
+            if (*c < '0' || *c > '9' || n > 1000) return kSteerLostLooks;
+            n = n * 10 + static_cast<unsigned>(*c - '0');
+        }
+        return n >= 1 && n <= 240 ? n : kSteerLostLooks;
+    }();
+    return looks;
+}
