diff --git a/tools/test-steer-blind.cpp b/tools/test-steer-blind.cpp
new file mode 100644
index 0000000..0336a12
--- /dev/null
+++ b/tools/test-steer-blind.cpp
@@ -0,0 +1,32 @@
+// Host test for EDEN_TEST_STEER_BLIND_LOOKS (17 Nov 2026): with the marker lost for a stretch (a Peahat hit),
+// the stick keeps its direction for the set number of looks, then Link stands; the old limit (4) stands at once.
+#include "../headless/minimap_steer.h"
+#include <cstdio>
+#include <utility>
+#include <vector>
+using steer::Walk;
+static int fails = 0;
+#define CHECK(c) do { if (!(c)) { std::printf("FAIL line %d: %s\n", __LINE__, #c); ++fails; } } while (0)
+// looks: true = marker and wedge seen at (500,500), false = lost. Returns how the looks went.
+static std::vector<Walk::Do> Run(const std::vector<bool>& looks, unsigned lost_looks) {
+    Walk w; std::vector<std::pair<unsigned, unsigned>> pts{{500, 100}}; std::vector<Walk::Do> out;
+    for (bool s : looks) {
+        steer::Fix f; f.found = s; f.view = s; f.x = 500; f.y = 500; f.angle = 0;
+        steer::Stick st; out.push_back(w.Look(f, pts, 6, lost_looks, st));
+    }
+    return out;
+}
+int main() {
+    std::vector<bool> hit{true, true}; hit.insert(hit.end(), 10, false); hit.push_back(true);
+    auto old = Run(hit, 4);    // as before: 3 looks keep, the 4th stands
+    CHECK(old[2] == Walk::Do::Keep && old[4] == Walk::Do::Keep && old[5] == Walk::Do::Stand);
+    CHECK(old[11] == Walk::Do::Stand && old[12] == Walk::Do::Hold);
+    auto blind = Run(hit, 16); // 10 lost looks < 16: never stands, keeps running through the hit
+    for (int i = 2; i <= 11; ++i) CHECK(blind[i] == Walk::Do::Keep);
+    CHECK(blind[12] == Walk::Do::Hold);
+    std::vector<bool> menu{true}; menu.insert(menu.end(), 30, false);
+    auto longer = Run(menu, 16); // a real menu or talk: still stands, after 16 looks (8 s)
+    CHECK(longer[15] == Walk::Do::Keep && longer[16] == Walk::Do::Stand && longer[30] == Walk::Do::Stand);
+    std::printf(fails ? "%d FAILED\n" : "all passed\n", fails);
+    return fails != 0;
+}
