+#!/usr/bin/env python3
+"""Checks for tools/route-from-recording.py: python3 tools/test-route-from-recording.py"""
+import importlib.util
+import pathlib
+import re
+
+spec = importlib.util.spec_from_file_location('rfr', pathlib.Path(__file__).with_name('route-from-recording.py'))
+rfr = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(rfr)
+
+fails = 0
+
+
+def check(cond, what):
+    global fails
+    if not cond:
+        fails += 1
+        print('FAIL', what)
+
+
+rec = ['# EDEN_TEST recorded input: ...',
+       '20.000 CIRCLE 150',          # title
+       '22.000 DOWN 120',            # menu
+       '23.000 CIRCLE 150']          # load
+# Walk 1: 30 s to 40 s, straight up the map from 800,800 to 800,700, one position every 0.5 s.
+for k in range(21):
+    rec.append(f'# POS {30 + 0.5 * k:.3f} 800.0 {800 - 5 * k:.1f} 0')
+rec += ['30.100 LSTICK 128 0 9000', '35.000 CROSS 100',  # inside the walk: left out
+        '39.500 LSTICK 128 0 400']                         # in the last second: replayed after the STEER
+rec.append('# POS 40.500 lost')                           # the load
+# Standing in the new area (positions that barely move): not a walk.
+for k in range(10):
+    rec.append(f'# POS {50 + 0.5 * k:.3f} 300.0 300.0 90')
+rec += ['52.000 TRIANGLE 200', '# ended at 60.000']
+
+out, ws = rfr.convert(rec, 'synthetic')
+text = '\n'.join(out)
+check(len(ws) == 1, f'one walk, got {len(ws)}')
+steer = [l for l in out if ' STEER ' in l and not l.startswith('#')]
+check(len(steer) == 1, 'one STEER line')
+if steer:
+    s = steer[0].split()
+    check(s[0] == '30', f'STEER at 30 s from the section start (lines in a section count from its start), got {s[0]}')
+    check(s[2] == '30', f'timeout 2*10+10 = 30, got {s[2]}')
+    pts = [tuple(map(int, p.split(','))) for p in s[3:] if ',' in p]
+    check(pts[-1] == (800, 700), f'last point is where the walk ended, got {pts[-1] if pts else None}')
+    check(all(abs(a[1] - b[1]) >= 12 for a, b in zip(pts[:-1], pts[1:-1])), 'points at least 12 apart (the end point may be closer)')
+    check((800, 800) not in pts, 'the start point (where Link stands) is not a target')
+    check(s[-1] == 'r=6', 'radius')
+check(re.search(r'^20 CIRCLE 150$', text, re.M) and re.search(r'^22 DOWN 120$', text, re.M),
+      'menu lines before the walk keep their times from the section start')
+body = '\n'.join(l for l in out if not l.startswith('#'))
+check('9000' not in body,
+      'the walk\'s long stick push is left out after the STEER')
+check(any(l.startswith('# walk') and 'CROSS' in l for l in out), 'a button pressed during the walk is named in the walk comment')
+check(re.search(r'^0 LSTICK 128 0 400$', text, re.M) is not None, 'the last second\'s push replays at 0 after the STEER')
+check(re.search(r'^12 TRIANGLE 200$', text, re.M) is not None, 'a later press is timed from the walk end (52 - 40)')
+# No positions at all: the recording comes back as a plain replay.
+plain, ws2 = rfr.convert(['10.000 CIRCLE 100', '12.500 LSTICK 128 0 300'], 'plain')
+check(len(ws2) == 0 and plain[1:] == ['10 CIRCLE 100', '12.5 LSTICK 128 0 300'], f'no positions: unchanged, got {plain[1:]}')
+# A jump on the map (area change without a lost line) splits the walk.
+jump = [f'# POS {k * 0.5:.3f} 500.0 {500 - 6 * k:.1f} 0' for k in range(10)] + \
+       [f'# POS {5 + k * 0.5:.3f} 100.0 {900 - 6 * k:.1f} 0' for k in range(10)]
+_, ws3 = rfr.convert(jump, 'jump')
+check(len(ws3) == 2, f'a 400 per mille jump splits into two walks, got {len(ws3)}')
+print(f'{fails} FAILED' if fails else 'all route-from-recording checks passed')
+raise SystemExit(1 if fails else 0)
