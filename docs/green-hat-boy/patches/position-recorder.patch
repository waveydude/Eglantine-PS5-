@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+"""Turn a recording with minimap positions into a steered route script.
+
+  route-from-recording.py <recorded-input.txt> [-o route.txt]
+
+EDEN_TEST_RECORD writes what player 1 pressed and, every 0.5 s, where Link's arrowhead was on the
+minimap ("# POS <s> <x> <y> <angle>", "# POS <s> lost"; headless/test_harness.h). A plain replay
+of the presses drifts: loads and lag move the timing, so Link ends up off the path. Here every walk
+(a run of positions with the map up, at least MIN_WALK_S long and MIN_TRAVEL per mille of travel)
+becomes a STEER leg through points taken from the walk every SPACING per mille, so the app walks to
+where Link actually went instead of pushing the stick blind. Everything else (menus, talks, doors,
+the last TAIL_S seconds of a walk, which push through a load trigger) is replayed as recorded.
+
+Sections: the harness times the lines after a STEER from the moment it is met, so each line after
+a walk is written relative to the end of that walk in the recording. Lines inside a walk (stick
+moves and buttons) are left out and listed as comments, so nothing is lost silently.
+Check the result with the GBB lint (tools/GrowingBlackBeans/steer/kokiri-four-stops/lint.py).
+"""
+import argparse
+import math
+import re
+import sys
+
+SPACING = 12.0     # per mille between STEER points
+RADIUS = 6         # r= of each STEER (the harness default)
+MIN_WALK_S = 3.0   # a shorter walk is replayed as recorded
+MIN_TRAVEL = 30.0  # per mille; less is standing or turning
+JUMP = 60.0        # per mille between two looks: a new map (area change), so a new walk
+GAP_S = 1.6        # seconds between two positions (more than three looks): the walk ends
+TAIL_S = 1.0       # the last second of a walk is replayed as recorded (pushes through a door)
+
+EVENT = re.compile(r'^\s*(\d+(?:\.\d+)?)\s+(\S+)(.*)$')
+POS = re.compile(r'^#\s*POS\s+(\d+(?:\.\d+)?)\s+(?:(lost)|(-?\d+(?:\.\d+)?)\s+(-?\d+(?:\.\d+)?)\s+(-?\d+(?:\.\d+)?))')
+
+
+def read(lines):
+    events, positions = [], []
+    for raw in lines:
+        line = raw.rstrip('\n')
+        m = POS.match(line)
+        if m:
+            t = float(m.group(1))
+            positions.append((t, None) if m.group(2) else (t, (float(m.group(3)), float(m.group(4)))))
+            continue
+        if line.lstrip().startswith('#') or not line.strip():
+            continue
+        m = EVENT.match(line)
+        if not m:
+            raise ValueError(f'unreadable line: {line!r}')
+        events.append((float(m.group(1)), m.group(2), m.group(3).strip()))
+    events.sort(key=lambda e: e[0])
+    return events, positions
+
+
+def walks(positions):
+    """Runs of known positions on one map, split at a lost map, a jump or a gap."""
+    out, cur = [], []
+    for t, p in positions:
+        if p is None:
+            if cur: out.append(cur)
+            cur = []
+            continue
+        if cur and (t - cur[-1][0] > GAP_S or math.dist(p, cur[-1][1]) > JUMP):
+            out.append(cur)
+            cur = []
+        cur.append((t, p))
+    if cur: out.append(cur)
+    keep = []
+    for w in out:
+        travel = sum(math.dist(a[1], b[1]) for a, b in zip(w, w[1:]))
+        if w[-1][0] - w[0][0] >= MIN_WALK_S and travel >= MIN_TRAVEL:
+            keep.append(w)
+    return keep
+
+
+def points(walk):
+    pts = [walk[0][1]]
+    for _, p in walk[1:]:
+        if math.dist(p, pts[-1]) >= SPACING:
+            pts.append(p)
+    if math.dist(walk[-1][1], pts[-1]) > 0.5:
+        pts.append(walk[-1][1])
+    return pts[1:] if len(pts) > 1 else pts  # Link already stands on the first
+
+
+def fmt(s):
+    return f'{max(s, 0.0):.3f}'.rstrip('0').rstrip('.') if s > 0 else '0'
+
+
+def convert(lines, name='recording'):
+    events, positions = read(lines)
+    ws = walks(positions)
+    out = [f'# Steered route made by route-from-recording.py from {name}: {len(ws)} STEER legs, '
+           f'points every {SPACING:g} per mille, r={RADIUS}; everything else as recorded.']
+    cursor = 0.0
+    i = 0
+    for w in ws:
+        start, end = w[0][0], w[-1][0]
+        # Recorded lines before the walk, timed from the section start.
+        while i < len(events) and events[i][0] < start:
+            t, what, rest = events[i]
+            out.append(f'{fmt(t - cursor)} {what} {rest}'.rstrip())
+            i += 1
+        dropped = []
+        while i < len(events) and events[i][0] < end - TAIL_S:
+            dropped.append(events[i])
+            i += 1
+        pts = points(w)
+        timeout = max(20, int(2 * (end - start) + 10))
+        out.append(f'# walk {start:.1f}-{end:.1f} s ({len(pts)} points); recorded inside it and left out: '
+                   f'{len(dropped)} lines' + (f' (buttons: {", ".join(sorted({d[1] for d in dropped if "STICK" not in d[1]}))})'
+                                             if any('STICK' not in d[1] for d in dropped) else ''))
+        out.append(f'{fmt(start - cursor)} STEER {timeout} ' +
+                   ' '.join(f'{x:.0f},{y:.0f}' for x, y in pts) + f' r={RADIUS}')
+        cursor = end
+        # The walk's last second (a push through a door or a load) is replayed from the moment the STEER is met.
+    while i < len(events):
+        t, what, rest = events[i]
+        out.append(f'{fmt(t - cursor)} {what} {rest}'.rstrip())
+        i += 1
+    return out, ws
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('recording')
+    ap.add_argument('-o', '--out')
+    a = ap.parse_args()
+    with open(a.recording) as f:
+        out, ws = convert(f, a.recording.split('/')[-1])
+    text = '\n'.join(out) + '\n'
+    if a.out:
+        open(a.out, 'w').write(text)
+    else:
+        sys.stdout.write(text)
+    print(f'{len(ws)} walks steered', file=sys.stderr)
+
+
+if __name__ == '__main__':
+    main()
