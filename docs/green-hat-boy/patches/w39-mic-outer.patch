diff --git a/tools/test-hum-notes.cpp b/tools/test-hum-notes.cpp
new file mode 100644
index 0000000..90ca487
--- /dev/null
+++ b/tools/test-hum-notes.cpp
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Host test for headless/hum_notes.h (EDEN_UP_MIC_NOTES).
+//   c++ -std=c++20 -O1 -fsanitize=address,undefined -Iheadless tools/test-hum-notes.cpp -o /tmp/t && /tmp/t
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <numbers>
+#include <random>
+#include <vector>
+
+#include "hum_notes.h"
+
+namespace H = Eden::Hum;
+static int failures = 0;
+#define CHECK(cond)                                                                                \
+    do {                                                                                           \
+        if (!(cond)) {                                                                             \
+            std::printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);                            \
+            ++failures;                                                                            \
+        }                                                                                          \
+    } while (0)
+
+static float Hz(float midi) {
+    return 440.0f * std::pow(2.0f, (midi - 69.0f) / 12.0f);
+}
+
+// A hum: the fundamental with two weaker harmonics, as a voice has, plus a little noise.
+static std::vector<std::int16_t> Tone(float hz, float amplitude, unsigned seed = 1) {
+    std::vector<std::int16_t> out(H::Window);
+    std::mt19937 rng{seed};
+    std::normal_distribution<float> noise{0.0f, amplitude * 0.03f};
+    for (std::size_t i = 0; i < out.size(); ++i) {
+        const float t = static_cast<float>(i) / H::Rate;
+        const float w = 2 * std::numbers::pi_v<float> * hz * t;
+        const float s = amplitude * (std::sin(w) + 0.5f * std::sin(2 * w) + 0.25f * std::sin(3 * w)) / 1.75f;
+        out[i] = static_cast<std::int16_t>(std::lround(std::fmax(-32768.0f, std::fmin(32767.0f, s + noise(rng)))));
+    }
+    return out;
+}
+
+static float Detect(const std::vector<std::int16_t>& s) {
+    return H::DetectPitch(s.data(), s.size());
+}
+
+// Pitches across the hummed range come back within a few cents, harmonics or not.
+static void PitchAccuracy() {
+    for (float midi = 40.0f; midi <= 84.0f; midi += 1.0f) { // E2 .. C6
+        const float hz = Hz(midi);
+        const float found = Detect(Tone(hz, 8000.0f, static_cast<unsigned>(midi)));
+        const float cents = found > 0 ? 1200.0f * std::log2(found / hz) : 9999.0f;
+        if (std::fabs(cents) > 20.0f) std::printf("  midi %.0f: %.1f Hz -> %.1f Hz (%.0f cents)\n", midi, hz, found, cents);
+        CHECK(std::fabs(cents) <= 20.0f);
+    }
+}
+
+// Silence, a quiet room and white noise have no pitch; a window shorter than two of the longest
+// periods is refused rather than read past.
+static void NoPitch() {
+    CHECK(Detect(std::vector<std::int16_t>(H::Window, 0)) == 0.0f);
+    CHECK(Detect(Tone(220.0f, 150.0f)) == 0.0f); // under MinRms
+    std::vector<std::int16_t> noise(H::Window);
+    std::mt19937 rng{7};
+    std::uniform_int_distribution<int> any{-12000, 12000};
+    for (auto& s : noise) s = static_cast<std::int16_t>(any(rng));
+    CHECK(Detect(noise) == 0.0f);
+    const auto tone = Tone(220.0f, 8000.0f);
+    CHECK(H::DetectPitch(tone.data(), 300) == 0.0f);
+    CHECK(H::DetectPitch(nullptr, H::Window) == 0.0f);
+    CHECK(Detect(Tone(40.0f, 8000.0f)) == 0.0f); // below MinHz
+}
+
+// Note names in any octave; between two notes nothing; the D goes high only above a recent note.
+static void Classify() {
+    const float none = std::nanf("");
+    CHECK(H::Classify(Hz(62), none) == H::LowD); // D4
+    CHECK(H::Classify(Hz(50), none) == H::LowD); // D3, an octave down
+    CHECK(H::Classify(Hz(53), none) == H::F);
+    CHECK(H::Classify(Hz(57), none) == H::A);
+    CHECK(H::Classify(Hz(59), none) == H::B);
+    CHECK(H::Classify(Hz(71), none) == H::B);    // B4
+    CHECK(H::Classify(Hz(60), none) == H::None); // C: a whole tone from D and from B
+    CHECK(H::Classify(Hz(55), none) == H::None); // G
+    CHECK(H::Classify(Hz(62.7f), none) == H::LowD);  // 70 cents sharp still counts
+    CHECK(H::Classify(Hz(62.8f), none) == H::None);  // 80 cents is too far
+    CHECK(H::Classify(Hz(52.25f), none) == H::F);    // 75 cents flat of F counts
+    CHECK(H::Classify(0.0f, none) == H::None);
+    CHECK(H::Classify(Hz(62), 59.0f) == H::HighD);   // D4 above a B3
+    CHECK(H::Classify(Hz(50), 59.0f) == H::LowD);    // D3 below it
+}
+
+// Two agreeing windows start a note; a different note releases first; silence releases; nothing
+// unarmed; the idle limit disarms.
+static void Tracker() {
+    H::Tracker t;
+    std::int64_t now = 0;
+    const auto feed = [&](float hz) { now += 32; return t.Feed(hz, now); };
+    CHECK(feed(Hz(57)) == H::None); // not armed
+    t.Arm(now);
+    CHECK(feed(Hz(57)) == H::None); // one window
+    CHECK(feed(Hz(57)) == H::A);    // two in a row
+    CHECK(feed(Hz(57)) == H::A);
+    CHECK(feed(Hz(53)) == H::None); // a different note releases A first
+    CHECK(feed(Hz(53)) == H::F);
+    CHECK(feed(0.0f) == H::None);   // silence releases
+    CHECK(feed(Hz(62)) == H::None);
+    CHECK(feed(0.0f) == H::None);   // one stray window never presses
+    CHECK(feed(Hz(62)) == H::None);
+    // Zelda's Lullaby goes B up to D: the D after a B is the high one.
+    CHECK(feed(Hz(59)) == H::None);
+    CHECK(feed(Hz(59)) == H::B);
+    CHECK(feed(Hz(62)) == H::None);
+    CHECK(feed(Hz(62)) == H::HighD);
+    // Song of Time goes A down to D: low.
+    CHECK(feed(Hz(57)) == H::None);
+    CHECK(feed(Hz(57)) == H::A);
+    CHECK(feed(Hz(50)) == H::None);
+    CHECK(feed(Hz(50)) == H::LowD);
+    CHECK(t.Held() == H::LowD);
+    t.Disarm();
+    CHECK(t.Held() == H::None);
+    CHECK(feed(Hz(57)) == H::None);
+    // Idle: after IdleDisarmMs without a note, arming ends; a note just before keeps it.
+    t.Arm(now);
+    now += H::IdleDisarmMs - 100;
+    CHECK(t.Feed(Hz(57), now) == H::None && t.Armed());
+    now += H::IdleDisarmMs + 1;
+    CHECK(t.Feed(0.0f, now) == H::None);
+    CHECK(!t.Armed());
+    // The high-D context expires.
+    t.Arm(now);
+    feed(Hz(59));
+    feed(Hz(59));
+    now += H::HighDContextMs + 100;
+    feed(0.0f);
+    feed(Hz(62));
+    CHECK(feed(Hz(62)) == H::LowD);
+}
+
+// End to end: tones through DetectPitch into the tracker.
+static void EndToEnd() {
+    H::Tracker t;
+    t.Arm(0);
+    std::int64_t now = 0;
+    H::Note last = H::None;
+    for (int i = 0; i < 4; ++i) last = t.Feed(Detect(Tone(Hz(53), 6000.0f, i)), now += 32);
+    CHECK(last == H::F);
+    last = t.Feed(Detect(std::vector<std::int16_t>(H::Window, 0)), now += 32);
+    CHECK(last == H::None);
+}
+
+int main() {
+    PitchAccuracy();
+    NoPitch();
+    Classify();
+    Tracker();
+    EndToEnd();
+    if (failures) {
+        std::printf("%d failure(s)\n", failures);
+        return 1;
+    }
+    std::puts("hum notes PASS");
+    return 0;
+}
diff --git a/tools/test-mic-feed.cpp b/tools/test-mic-feed.cpp
new file mode 100644
index 0000000..e5d1d56
--- /dev/null
+++ b/tools/test-mic-feed.cpp
@@ -0,0 +1,228 @@
+#include <cassert>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <array>
+#include <algorithm>
+#include <cmath>
+
+// Simulated Sysmix ring buffer
+struct SysmixBuffer {
+    std::vector<uint8_t> mem;
+    static constexpr uint64_t Size = 0xd000;
+    static constexpr uint32_t Frames = 4800;
+    static constexpr uint32_t Capacity = Frames + 1; // 4801
+    static constexpr uint64_t DataOffset = 0x2000;
+    static constexpr uint64_t SysIndexOffset = 0x44;
+    static constexpr uint64_t GameIndexOffset = 0x1004;
+
+    SysmixBuffer() : mem(Size, 0) {
+        // Offset 0 = 1 (initialized)
+        Write32(0x0, 1);
+        Write32(SysIndexOffset, 0);
+        Write32(GameIndexOffset, 0);
+    }
+
+    uint32_t Read32(uint64_t offset) const {
+        uint32_t v;
+        std::memcpy(&v, &mem[offset], sizeof(v));
+        return v;
+    }
+
+    void Write32(uint64_t offset, uint32_t v) {
+        std::memcpy(&mem[offset], &v, sizeof(v));
+    }
+
+    int16_t Read16(uint64_t offset) const {
+        int16_t v;
+        std::memcpy(&v, &mem[offset], sizeof(v));
+        return v;
+    }
+
+    void Write16(uint64_t offset, int16_t v) {
+        std::memcpy(&mem[offset], &v, sizeof(v));
+    }
+};
+
+// Simulated Bounded Mic Capture Ring (as in mic_capture.cpp)
+struct BoundedMicRing {
+    static constexpr size_t BufferSize = 9600;
+    static constexpr size_t MaxLatencyFrames = 4800; // 100ms cap at 48kHz
+    std::array<int16_t, BufferSize> ring{};
+    size_t ring_write = 0;
+    size_t ring_count = 0;
+    uint64_t drops = 0;
+    uint64_t underruns = 0;
+
+    void Push(const int16_t* samples, size_t count) {
+        for (size_t i = 0; i < count; ++i) {
+            ring[ring_write] = samples[i];
+            ring_write = (ring_write + 1) % BufferSize;
+            if (ring_count < MaxLatencyFrames) {
+                ring_count++;
+            } else {
+                drops++; // Oldest sample dropped to preserve sub-100ms real-time latency
+            }
+        }
+    }
+
+    size_t Read(int16_t* out, size_t frames) {
+        const size_t take = std::min(frames, ring_count);
+        if (take < frames) {
+            underruns += (frames - take);
+        }
+        const size_t start = (ring_write + BufferSize - ring_count) % BufferSize;
+        for (size_t i = 0; i < take; ++i) {
+            out[i] = ring[(start + i) % BufferSize];
+        }
+        ring_count -= take;
+        return take;
+    }
+};
+
+// Simulated Drain logic
+void SimDrain(SysmixBuffer& buf, BoundedMicRing& mic, double& owed_frames, uint64_t& mic_fed, uint64_t& mic_silence) {
+    const uint32_t capacity = SysmixBuffer::Capacity;
+    const uint32_t produced = buf.Read32(SysmixBuffer::SysIndexOffset);
+    const uint32_t consumed = buf.Read32(SysmixBuffer::GameIndexOffset);
+
+    if (produced >= capacity || consumed >= capacity) return;
+
+    // 5ms at 48000 Hz = 240 frames
+    owed_frames += 48000.0 * 0.005;
+    const auto owed = static_cast<uint32_t>(owed_frames);
+    owed_frames -= owed;
+
+    const uint32_t waiting = (produced + capacity - consumed) % capacity;
+    const uint32_t room = capacity - 1 - waiting;
+    const uint32_t count = std::min(owed, room);
+
+    std::array<int16_t, 1024> samples{};
+    const uint32_t wanted = std::min<uint32_t>(count, samples.size());
+    const size_t got = mic.Read(samples.data(), wanted);
+
+    for (uint32_t i = 0; i < wanted; ++i) {
+        buf.Write16(SysmixBuffer::DataOffset + uint64_t{(produced + i) % capacity} * 2, samples[i]);
+    }
+    buf.Write32(SysmixBuffer::SysIndexOffset, (produced + wanted) % capacity);
+
+    mic_fed += wanted;
+    mic_silence += (wanted - got);
+}
+
+// Simulated Game Audio Thread reading from ring
+size_t SimGameRead(SysmixBuffer& buf, std::vector<int16_t>& out) {
+    const uint32_t capacity = SysmixBuffer::Capacity;
+    const uint32_t produced = buf.Read32(SysmixBuffer::SysIndexOffset);
+    const uint32_t consumed = buf.Read32(SysmixBuffer::GameIndexOffset);
+
+    if (produced >= capacity || consumed >= capacity) return 0;
+
+    const uint32_t available = (produced + capacity - consumed) % capacity;
+    for (uint32_t i = 0; i < available; ++i) {
+        int16_t s = buf.Read16(SysmixBuffer::DataOffset + uint64_t{(consumed + i) % capacity} * 2);
+        out.push_back(s);
+    }
+    buf.Write32(SysmixBuffer::GameIndexOffset, (consumed + available) % capacity);
+    return available;
+}
+
+int main() {
+    printf("Starting Sysmix Mic Feed test...\n");
+
+    SysmixBuffer buf;
+    BoundedMicRing mic;
+    double owed = 0;
+    uint64_t fed = 0, silence = 0;
+
+    // Test 1: Mic feeds sine wave, Drain runs, Game consumes
+    // DualSense input sends 256 samples every ~5.33 ms
+    // Drain consumes 240 samples every 5.0 ms
+    std::vector<int16_t> game_received;
+    int16_t sample_counter = 1;
+
+    for (int tick = 0; tick < 200; ++tick) {
+        // Producer: DualSense hardware delivers 256 samples approx every tick
+        int16_t hw_block[256];
+        for (int i = 0; i < 256; ++i) {
+            hw_block[i] = sample_counter++;
+        }
+        mic.Push(hw_block, 256);
+
+        // System Drain (5ms)
+        SimDrain(buf, mic, owed, fed, silence);
+
+        // Game consumes
+        SimGameRead(buf, game_received);
+    }
+
+    printf("Test 1 Result: Fed %llu frames (%llu silence). Game received %zu frames.\n",
+           (unsigned long long)fed, (unsigned long long)silence, game_received.size());
+    assert(game_received.size() == fed);
+    assert(silence == 0); // All frames came from mic
+    // Verify waveform continuity
+    for (size_t i = 0; i < game_received.size(); ++i) {
+        assert(game_received[i] == static_cast<int16_t>(i + 1));
+    }
+    printf("Test 1 PASS: Perfect PCM continuity and timing!\n");
+
+    // Test 2: Silence fallback when mic underruns / disconnected
+    game_received.clear();
+    BoundedMicRing empty_mic;
+    for (int tick = 0; tick < 20; ++tick) {
+        SimDrain(buf, empty_mic, owed, fed, silence);
+        SimGameRead(buf, game_received);
+    }
+    assert(game_received.size() == 20 * 240);
+    for (auto s : game_received) {
+        assert(s == 0); // Pure silence
+    }
+    printf("Test 2 PASS: Silent fallback produces perfect 48kHz silence!\n");
+
+    // Test 3: Game stalls / pauses reading (e.g. 1 second pause)
+    // Producer keeps pushing, Drain fills ring to capacity (4800 frames) and then drops gracefully
+    sample_counter = 1000;
+    for (int tick = 0; tick < 50; ++tick) { // 50 * 240 = 12000 frames attempted
+        int16_t hw_block[256];
+        for (int i = 0; i < 256; ++i) hw_block[i] = sample_counter++;
+        mic.Push(hw_block, 256);
+        SimDrain(buf, mic, owed, fed, silence);
+        // Game does NOT read
+    }
+    uint32_t produced = buf.Read32(SysmixBuffer::SysIndexOffset);
+    uint32_t consumed = buf.Read32(SysmixBuffer::GameIndexOffset);
+    uint32_t waiting = (produced + SysmixBuffer::Capacity - consumed) % SysmixBuffer::Capacity;
+    printf("Test 3 Waiting frames in ring when stalled: %u (Capacity-1 = %u)\n", waiting, SysmixBuffer::Capacity - 1);
+    assert(waiting == SysmixBuffer::Capacity - 1); // exactly 4800 frames waiting
+
+    // Now Game wakes up and reads
+    game_received.clear();
+    SimGameRead(buf, game_received);
+    assert(game_received.size() == 4800);
+    produced = buf.Read32(SysmixBuffer::SysIndexOffset);
+    consumed = buf.Read32(SysmixBuffer::GameIndexOffset);
+    assert(produced == consumed); // Buffer drained!
+    printf("Test 3 PASS: Overrun gracefully bounds to 4800 frames, resume drains cleanly!\n");
+
+    // Test 4: Bounded latency check in BoundedMicRing
+    BoundedMicRing latency_mic;
+    int16_t test_val = 1;
+    // Push 20,000 samples (over 400 ms)
+    for (int i = 0; i < 20000; ++i) {
+        int16_t s = test_val++;
+        latency_mic.Push(&s, 1);
+    }
+    assert(latency_mic.ring_count == BoundedMicRing::MaxLatencyFrames);
+    assert(latency_mic.drops == 20000 - BoundedMicRing::MaxLatencyFrames);
+    // Read first sample: must be (20001 - MaxLatencyFrames), NOT sample 1!
+    int16_t read_back = 0;
+    latency_mic.Read(&read_back, 1);
+    printf("Latency test: first read sample = %d (expected %zu)\n", read_back, 20001 - BoundedMicRing::MaxLatencyFrames);
+    assert(read_back == static_cast<int16_t>(20001 - BoundedMicRing::MaxLatencyFrames));
+    printf("Test 4 PASS: Stale audio dropped, real-time latency strictly capped at 100ms!\n");
+
+    printf("ALL TESTS PASSED SUCCESSFULLY!\n");
+    return 0;
+}
