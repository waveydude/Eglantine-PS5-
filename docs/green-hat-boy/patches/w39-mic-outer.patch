--- /dev/null
+++ b/tools/test-mic-log.cpp
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Host test for Eglantine's src/common/nx2_mic_log.h (patch 1107): the EDEN_MIC_FEED / EDEN_MIC_DUMP
+// index lines are written for the whole session, not only the first 200.
+//   c++ -std=c++20 -O1 -fsanitize=address,undefined -I<patched Eglantine>/src tools/test-mic-log.cpp
+#include <cstdio>
+#include "common/nx2_mic_log.h"
+using namespace Common::Nx2MicLog;
+static int failures = 0;
+#define CHECK(c) do { if (!(c)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); ++failures; } } while (0)
+// Runs `seconds` seconds of 200 drains each with the indices `idx(second)`; returns lines written.
+template <class F> static int Run(Pacer& p, u32& shared, int seconds, F idx) {
+    int lines = 0;
+    for (int s = 0; s < seconds; ++s)
+        for (int d = 0; d < 200; ++d)
+            lines += Due(p, idx(s), shared);
+    return lines;
+}
+int main() {
+    { // Indices never move: 200 lines, then one every 10 s; never more than one a second.
+        Pacer p; u32 shared = 0;
+        CHECK(Run(p, shared, 200, [](int) { return u64{4800}; }) == 200);
+        CHECK(Run(p, shared, 100, [](int) { return u64{4800}; }) == 10);
+    }
+    { // The bug this replaced: past the cap the old code re-checked every drain. 3600 s: at most 3600 lines.
+        Pacer p; u32 shared = 0;
+        const int lines = Run(p, shared, 3600, [](int s) { return u64(s % 2); }); // moves every second
+        CHECK(lines == 3600);
+        Pacer q; u32 shared2 = 0;
+        CHECK(Run(q, shared2, 3600, [](int) { return u64{7}; }) == 200 + (3600 - 200) / 10);
+    }
+    { // A move after the cap is reported at the next chance, and only once.
+        Pacer p; u32 shared = 0;
+        (void)Run(p, shared, 250, [](int) { return u64{0}; });
+        int lines = Run(p, shared, 3, [](int s) { return s == 0 ? u64{1} : u64{1}; });
+        CHECK(lines == 1);
+    }
+    { // No line between chances: exactly one chance per 200 drains.
+        Pacer p; u32 shared = 0;
+        for (int d = 0; d < 199; ++d) CHECK(!Due(p, d, shared));
+        CHECK(Due(p, 0, shared));
+        CHECK(shared == 1);
+    }
+    { // The count is shared between streams: the early lines are 200 in all, not per stream.
+        Pacer a, b; u32 shared = 0;
+        int la = 0, lb = 0;
+        for (int s = 0; s < 150; ++s) for (int d = 0; d < 200; ++d) { la += Due(a, 5, shared); lb += Due(b, 5, shared); }
+        CHECK(la + lb >= 200 && la + lb <= 200 + 2 * 5);
+    }
+    CHECK(Pack(1, 2) != Pack(2, 1) && Pack(0, 4800) != Pack(4800, 0));
+    if (failures == 0) std::puts("PASS");
+    return failures != 0;
+}
