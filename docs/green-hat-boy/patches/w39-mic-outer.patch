diff --git a/tools/build-audio-in-stub.sh b/tools/build-audio-in-stub.sh
new file mode 100755
index 0000000..c67f6e1
--- /dev/null
+++ b/tools/build-audio-in-stub.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Builds build/stubs/libSceAudioIn.so, the libSceAudioIn import facade the controller mic
+# capture links against (tools/stubs/libSceAudioIn.c), with the Payload SDK's compiler.
+set -euo pipefail
+root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
+sdk="$root/../ps5-native-app-boilerplate/.deps/native/ps5-payload-sdk"
+source="$root/tools/stubs/libSceAudioIn.c"
+out="$root/build/stubs/libSceAudioIn.so"
+[[ -f $out && $out -nt $source ]] && exit 0
+test -x "$sdk/bin/prospero-clang" || { echo "Missing the Payload SDK; run make deps" >&2; exit 1; }
+mkdir -p "$root/build/stubs"
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+PS5_PAYLOAD_SDK="$sdk" "$sdk/bin/prospero-clang" -fPIC -c "$source" -o "$work/libSceAudioIn.o"
+"$sdk/bin/prospero-lld" --shared -soname libSceAudioIn.sprx -o "$work/libSceAudioIn.so" "$work/libSceAudioIn.o"
+mv "$work/libSceAudioIn.so" "$out"
