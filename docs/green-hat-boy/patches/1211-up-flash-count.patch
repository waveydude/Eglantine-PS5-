+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <string_view>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+#include "core/frontend/framebuffer_layout.h"
+#include "video_core/flash_counter.h"
+#include "video_core/renderer_vulkan/present/util.h"
+#include "video_core/renderer_vulkan/vk_present_manager.h"
+#include "video_core/renderer_vulkan/vk_scheduler.h"
+#include "video_core/vulkan_common/vulkan_memory_allocator.h"
+#include "video_core/vulkan_common/vulkan_wrapper.h"
+
+namespace Vulkan {
+
+/// EDEN_UP_FLASH_COUNT=1 (exact "1"; off by default): counts one-frame flashes in what is shown
+/// (video_core/flash_counter.h). Built as BlackProbe is: at each composite, 576 single pixels on a
+/// 32x18 grid inside the drawn area of the frame image are copied into one of Slots small host
+/// buffers with the present's own commands (no extra submit), and a slot is read at a later
+/// composite once the GPU is past it (Scheduler::IsFree). Nothing ever waits for it. A frame whose
+/// slot is still on the GPU gets no probe, and the detector starts over after it, so no flash is
+/// judged across a missing frame (the 10 s line says how many were missed).
+/// Lines: "EDEN_UP_FLASH_COUNT last 10 s: ..." every 10 s, and one "EDEN_UP_FLASH ..." per flash
+/// (at most 20 per 10 s). Tuning, read once: EDEN_UP_FLASH_COUNT_JUMP (default 48, 0-255),
+/// EDEN_UP_FLASH_COUNT_SHARE_PERMILLE (default 40 = 4% of the points).
+/// Cost while on: 576 one-pixel copies (2.3 KB) and two barriers per present on the GPU, a 2.3 KB
+/// read and 576 compares on the GPU thread. Off: one test of a static per composite.
+class FlashProbe {
+public:
+    static constexpr u32 Samples = VideoCommon::FlashCount::Samples;
+    static constexpr u32 Slots = 4;
+
+    static bool Enabled() {
+        static const bool on = Common::PeSwitch("EDEN_UP_FLASH_COUNT");
+        return on;
+    }
+
+    /// The GPU thread, in RendererVulkan::Composite after the frame is drawn, before its submit.
+    void AtComposite(MemoryAllocator& allocator, Scheduler& scheduler, Frame* frame,
+                     VkFormat format, const Layout::FramebufferLayout& layout) {
+        const u64 index = composites++;
+        if (disabled || frame == nullptr || !frame->image) {
+            return;
+        }
+        if (std::any_of(slots.begin(), slots.end(), [](const Slot& s) { return s.pending; })) {
+            scheduler.GetMasterSemaphore().Refresh();
+        }
+        // Oldest first, so the detector sees frames in order.
+        for (u32 i = 0; i < Slots; ++i) {
+            Slot& slot = slots[(next + i) % Slots];
+            if (slot.pending && scheduler.IsFree(slot.tick)) {
+                Read(slot);
+            }
+        }
+        Report();
+        if (Kind(format) == PixelKind::Unsupported) {
+            disabled = true;
+            LOG_WARNING(Render_Vulkan, "EDEN_UP_FLASH_COUNT: frame format {} is not probed; off for "
+                                       "this run", static_cast<int>(format));
+            return;
+        }
+        if (!made) {
+            try {
+                for (Slot& slot : slots) {
+                    slot.buffer = CreateWrappedBuffer(allocator, Samples * 4, MemoryUsage::Download);
+                }
+            } catch (const std::exception&) {
+                disabled = true;
+                LOG_WARNING(Render_Vulkan, "EDEN_UP_FLASH_COUNT: no memory for the probe; off for this run");
+                return;
+            }
+            made = true;
+            const auto number = [](const char* name, u32 fallback, u32 max) {
+                const char* const v = std::getenv(name);
+                if (v == nullptr || *v == '\0') return fallback;
+                char* end = nullptr;
+                const unsigned long n = std::strtoul(v, &end, 10);
+                return (end == v || *end != '\0' || n > max) ? fallback : static_cast<u32>(n);
+            };
+            VideoCommon::FlashCount::Params params;
+            params.jump = (std::max)(number("EDEN_UP_FLASH_COUNT_JUMP", params.jump, 255), params.settle + 1);
+            params.min_share_permille =
+                (std::max)(number("EDEN_UP_FLASH_COUNT_SHARE_PERMILLE", params.min_share_permille, 1000), 1U);
+            detector = VideoCommon::FlashCount::Detector{params};
+            LOG_INFO(Render_Vulkan,
+                     "EDEN_UP_FLASH_COUNT=1: one-frame flashes counted on {} points ({}x{}): a point "
+                     "jumps at least {} from both neighbouring frames while they agree within {}; a "
+                     "frame counts when {} per mille of the points do",
+                     Samples, VideoCommon::FlashCount::Cols, VideoCommon::FlashCount::Rows,
+                     params.jump, params.settle, params.min_share_permille);
+            window_start = std::chrono::steady_clock::now();
+        }
+        Slot& slot = slots[next];
+        if (slot.pending) {
+            ++skipped;
+            return;
+        }
+        const u32 left = (std::min)(layout.screen.left, frame->width - 1);
+        const u32 top = (std::min)(layout.screen.top, frame->height - 1);
+        const u32 right = (std::clamp)(layout.screen.right, left + 1, frame->width);
+        const u32 bottom = (std::clamp)(layout.screen.bottom, top + 1, frame->height);
+        constexpr u32 Cols = VideoCommon::FlashCount::Cols, Rows = VideoCommon::FlashCount::Rows;
+        for (u32 y = 0; y < Rows; ++y) {
+            for (u32 x = 0; x < Cols; ++x) {
+                const u32 px = left + ((2 * x + 1) * (right - left)) / (2 * Cols);
+                const u32 py = top + ((2 * y + 1) * (bottom - top)) / (2 * Rows);
+                slot.regions[y * Cols + x] = VkBufferImageCopy{
+                    .bufferOffset = VkDeviceSize{(y * Cols + x) * 4U},
+                    .bufferRowLength = 0,
+                    .bufferImageHeight = 0,
+                    .imageSubresource{
+                        .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+                        .mipLevel = 0,
+                        .baseArrayLayer = 0,
+                        .layerCount = 1,
+                    },
+                    .imageOffset{.x = static_cast<s32>(px), .y = static_cast<s32>(py), .z = 0},
+                    .imageExtent{.width = 1, .height = 1, .depth = 1},
+                };
+            }
+        }
+        slot.format = format;
+        slot.index = index;
+        slot.pending = true;
+        slot.tick = scheduler.CurrentTick();
+        next = (next + 1) % Slots;
+        scheduler.RequestOutsideRenderPassOperationContext();
+        scheduler.Record([image = *frame->image, buffer = *slot.buffer,
+                          regions = slot.regions.data()](vk::CommandBuffer cmdbuf) {
+            static constexpr VkMemoryBarrier before{
+                .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+                .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+            };
+            static constexpr VkMemoryBarrier to_host{
+                .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+                .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+            };
+            cmdbuf.PipelineBarrier(vk::PIPELINE_STAGE_GRAPHICS_COMPUTE_TRANSFER,
+                                   VK_PIPELINE_STAGE_TRANSFER_BIT, 0, before);
+            // The frame image stays in GENERAL (the present pass's final layout), as BlackProbe's.
+            cmdbuf.CopyImageToBuffer(image, VK_IMAGE_LAYOUT_GENERAL, buffer,
+                                     vk::Span<VkBufferImageCopy>(regions, Samples));
+            cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0,
+                                   to_host);
+        });
+    }
+
+private:
+    enum class PixelKind { Unsupported, Bytes8, Packed10 };
+
+    struct Slot {
+        vk::Buffer buffer;
+        std::array<VkBufferImageCopy, Samples> regions{};
+        u64 tick{};
+        u64 index{};
+        VkFormat format{};
+        bool pending{};
+    };
+
+    static PixelKind Kind(VkFormat format) {
+        switch (format) {
+        case VK_FORMAT_B8G8R8A8_UNORM:
+        case VK_FORMAT_B8G8R8A8_SRGB:
+        case VK_FORMAT_R8G8B8A8_UNORM:
+        case VK_FORMAT_R8G8B8A8_SRGB:
+        case VK_FORMAT_A8B8G8R8_UNORM_PACK32:
+        case VK_FORMAT_A8B8G8R8_SRGB_PACK32:
+            return PixelKind::Bytes8;
+        case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+        case VK_FORMAT_A2R10G10B10_UNORM_PACK32:
+            return PixelKind::Packed10;
+        default:
+            return PixelKind::Unsupported;
+        }
+    }
+
+    /// The brightest colour channel, 0-255: the same measure BlackProbe uses, and independent of
+    /// the channel order of the 8-bit formats.
+    static u8 Brightest(const u8* pixel, PixelKind kind) {
+        if (kind == PixelKind::Bytes8) {
+            return (std::max)({pixel[0], pixel[1], pixel[2]});
+        }
+        u32 word{};
+        std::memcpy(&word, pixel, sizeof(word));
+        return static_cast<u8>((std::max)({word & 0x3ffU, (word >> 10) & 0x3ffU, (word >> 20) & 0x3ffU}) >> 2);
+    }
+
+    void Read(Slot& slot) {
+        slot.pending = false;
+        slot.buffer.Invalidate();
+        const auto bytes = slot.buffer.Mapped();
+        if (bytes.size() < Samples * 4) {
+            return;
+        }
+        const PixelKind kind = Kind(slot.format);
+        std::array<u8, Samples> luma{};
+        for (u32 i = 0; i < Samples; ++i) {
+            luma[i] = Brightest(bytes.data() + i * 4, kind);
+        }
+        ++probed;
+        if (const auto e = detector.Feed(slot.index, luma)) {
+            ++flashes;
+            ++total;
+            ++(e->brighter ? brighter : darker);
+            if (lines_this_window < 20) {
+                ++lines_this_window;
+                LOG_INFO(Render_Vulkan,
+                         "EDEN_UP_FLASH frame={} points={}/{} jump={} {} box={},{}-{},{} (32x18 grid)",
+                         e->frame, e->points, Samples, e->mean_jump, e->brighter ? "brighter" : "darker",
+                         e->x0, e->y0, e->x1, e->y1);
+            }
+        }
+    }
+
+    void Report() {
+        if (!made) {
+            return;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (now - window_start < std::chrono::seconds{10}) {
+            return;
+        }
+        LOG_INFO(Render_Vulkan,
+                 "EDEN_UP_FLASH_COUNT last 10 s: {} flashes ({} brighter, {} darker) in {} frames "
+                 "probed, {} not probed (slot busy); {} flashes this session",
+                 flashes, brighter, darker, probed, skipped, total);
+        flashes = brighter = darker = probed = skipped = lines_this_window = 0;
+        window_start = now;
+    }
+
+    std::array<Slot, Slots> slots{};
+    VideoCommon::FlashCount::Detector detector{};
+    std::chrono::steady_clock::time_point window_start{};
+    u64 composites{};
+    u64 total{};
+    u32 flashes{}, brighter{}, darker{}, probed{}, skipped{}, lines_this_window{};
+    u32 next{};
+    bool made{};
+    bool disabled{};
+};
+
+} // namespace Vulkan
