Subject: [PATCH] EDEN_UP_FLASH_COUNT=1: count one-frame flashes in the shown picture (off by default)

There was no flash measure that works: GrowingBlackBeans' gbb8 counter compared each frame's mean
brightness with a running median and saturated (close objects sweeping past count, more at low
fps), so flashes were rated by eye. This one samples 576 points (32x18) of every shown frame, with
the present's own commands and no wait (built as BlackProbe), and calls frame B a flash where it
jumps at least 48 (of 255) away from both neighbouring frames A and C while A and C agree within 16,
on at least 4% of the points. A camera move, a fade or a scene cut changes A to C too and is never
counted. Lines: "EDEN_UP_FLASH_COUNT last 10 s: ..." and one "EDEN_UP_FLASH frame=... points=...
box=..." per flash (at most 20 per 10 s). Tuning: EDEN_UP_FLASH_COUNT_JUMP,
EDEN_UP_FLASH_COUNT_SHARE_PERMILLE. A two-frame flash is not counted (documented limit). Detector
tested on the host: tools/test-flash-counter.cpp. Unset: one test of a static per composite.

--- /dev/null
+++ b/src/video_core/flash_counter.h
@@ -0,0 +1,105 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+// EDEN_UP_FLASH_COUNT=1 (waveydude, 15 Nov 2026): counts one-frame flashes in the shown picture.
+// GrowingBlackBeans' gbb8 counter compared each frame's mean brightness with a running median and
+// saturated: close objects sweeping past the camera count as flashes, more so at low fps. This one
+// looks at 576 points (32 x 18) of three shown frames in a row, A B C, and calls B a flash only
+// where B jumps away from both neighbours in the same direction while A and C agree with each
+// other. A camera move or a fade changes A to C as well, so it is never counted; a wrong picture
+// shown for one frame (the "split second" flashes, a bright patch of ground) is. A frame is a flash
+// when at least MinShare of the points do that. Pure logic: no Vulkan, tested on the host
+// (tools/test-flash-counter.cpp); present/flash_probe.h feeds it.
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdlib>
+#include <optional>
+#include <span>
+
+namespace VideoCommon::FlashCount {
+
+inline constexpr std::uint32_t Cols = 32;
+inline constexpr std::uint32_t Rows = 18;
+inline constexpr std::uint32_t Samples = Cols * Rows;
+
+struct Params {
+    std::uint32_t jump = 48;               ///< B must differ from A and from C by at least this (0-255)
+    std::uint32_t settle = 16;             ///< and A and C may differ by at most this
+    std::uint32_t min_share_permille = 40; ///< share of the points that must do so (40 = 4%)
+    // settle must stay under jump: the direction of a flash then needs no check (Judge).
+};
+
+struct Event {
+    std::uint64_t frame{};     ///< index of the flashing frame (B)
+    std::uint32_t points{};    ///< points that flashed, of Samples
+    std::uint32_t mean_jump{}; ///< mean of min(|B-A|, |B-C|) over those points
+    bool brighter{};           ///< most of them got brighter
+    std::uint32_t x0{}, y0{}, x1{}, y1{}; ///< grid box holding them (inclusive)
+};
+
+class Detector {
+public:
+    explicit Detector(Params params = {}) : p{params} {}
+
+    /// One shown frame's brightness at the Samples points, row by row. index counts shown frames;
+    /// a gap (a frame that was not probed) starts over, so no flash is ever judged across it.
+    /// Returns an event for the frame before this one when that frame flashed.
+    std::optional<Event> Feed(std::uint64_t index, std::span<const std::uint8_t, Samples> luma) {
+        std::optional<Event> event;
+        if (have == 0 || index != last + 1) {
+            have = 0;
+        } else if (have >= 2) {
+            event = Judge(index - 1, luma);
+        }
+        a = b;
+        std::copy(luma.begin(), luma.end(), b.begin());
+        last = index;
+        have = (std::min)(have + 1, 2);
+        return event;
+    }
+
+private:
+    std::optional<Event> Judge(std::uint64_t middle, std::span<const std::uint8_t, Samples> c) const {
+        Event e{.frame = middle, .x0 = Cols, .y0 = Rows};
+        std::uint64_t jump_sum = 0;
+        std::uint32_t up = 0;
+        for (std::uint32_t i = 0; i < Samples; ++i) {
+            const int va = a[i], vb = b[i], vc = c[i];
+            const int d1 = vb - va, d2 = vb - vc;
+            // With A and C within settle (< jump) of each other, a jump of at least jump from both
+            // puts B above both or below both: the direction needs no check of its own.
+            if (std::abs(va - vc) > static_cast<int>(p.settle)) {
+                continue;
+            }
+            const int j = (std::min)(std::abs(d1), std::abs(d2));
+            if (j < static_cast<int>(p.jump)) {
+                continue;
+            }
+            ++e.points;
+            jump_sum += static_cast<std::uint32_t>(j);
+            up += d1 > 0 ? 1 : 0;
+            const std::uint32_t x = i % Cols, y = i / Cols;
+            e.x0 = (std::min)(e.x0, x);
+            e.y0 = (std::min)(e.y0, y);
+            e.x1 = (std::max)(e.x1, x);
+            e.y1 = (std::max)(e.y1, y);
+        }
+        if (e.points == 0 || std::uint64_t{e.points} * 1000 < std::uint64_t{p.min_share_permille} * Samples) {
+            return std::nullopt;
+        }
+        e.mean_jump = static_cast<std::uint32_t>(jump_sum / e.points);
+        e.brighter = up * 2 >= e.points;
+        return e;
+    }
+
+    Params p;
+    std::array<std::uint8_t, Samples> a{}, b{};
+    std::uint64_t last{};
+    int have{};
+};
+
+} // namespace VideoCommon::FlashCount
